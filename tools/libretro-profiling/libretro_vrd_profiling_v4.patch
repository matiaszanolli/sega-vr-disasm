+
+static void vrd_trace_write_headers(void)
+{
+    int sh2_drc = (PicoIn.opt & POPT_EN_DRC) != 0;
+    const char *batching = vrd_profile_pc_enabled ? "chunked" : "normal";
+    int i;
+
+    if (vrd_caller_trace_log) {
+        if (fprintf(vrd_caller_trace_log,
+                "# VRD_CALLER_TRACE version=2 addr=0x%08X sh2_drc=%d "
+                "profile_pc=%d profile_pc_env=%d m68k_batching=%s "
+                "instruction_start_hook=%d composed=%d max_hits=%u\n",
+                (unsigned int)vrd_caller_trace_addr, sh2_drc, vrd_profile_pc_enabled,
+                vrd_profile_pc_env_present, batching,
+                vrd_instruction_hook_installed,
+                vrd_instruction_hook_installed, vrd_caller_trace_max) < 0 ||
+            fprintf(vrd_caller_trace_log,
+                "frame,pc,sp,return_addr\n") < 0 ||
+            fflush(vrd_caller_trace_log) != 0)
+            vrd_caller_trace_errors++;
+    }
+    if (vrd_write_trace_log) {
+        if (fprintf(vrd_write_trace_log,
+                "# VRD_WRITE_TRACE version=3 sh2_drc=%d profile_pc=%d "
+                "profile_pc_env=%d m68k_batching=%s instruction_start_hook=%d "
+                "composed=%d caller_addr=0x%08X caller_max=%u targets=%d\n",
+                sh2_drc, vrd_profile_pc_enabled, vrd_profile_pc_env_present,
+                batching, vrd_instruction_hook_installed,
+                vrd_instruction_hook_installed,
+                (unsigned int)vrd_caller_trace_addr,
+                vrd_caller_trace_max, vrd_write_trace_target_count) < 0)
+            vrd_write_trace_errors++;
+        for (i = 0; i < vrd_write_trace_target_count; i++) {
+            if (fprintf(vrd_write_trace_log,
+                    "# TARGET index=%d addr=0x%06X size=%u\n",
+                    i, vrd_write_trace_targets[i].addr,
+                    vrd_write_trace_targets[i].size) < 0)
+                vrd_write_trace_errors++;
