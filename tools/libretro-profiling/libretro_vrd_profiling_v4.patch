diff --git a/pico/32x/memory.c b/pico/32x/memory.c
index 12c3f73..ab97d34 100644
--- a/pico/32x/memory.c
+++ b/pico/32x/memory.c
@@ -1907,6 +1907,115 @@ static void REGPARM(3) sh2_write32_rom(u32 a, u32 d, SH2 *sh2)
 typedef u32 REGPARM(2) (sh2_read_handler)(u32 a, SH2 *sh2);
 typedef void REGPARM(3) (sh2_write_handler)(u32 a, u32 d, SH2 *sh2);
 
+#ifdef __LIBRETRO__
+typedef void (vrd_mmio_trace_master_observer_t)(
+    unsigned int pc, unsigned int address, unsigned int value,
+    unsigned int op, unsigned int width);
+static sh2_read_handler *vrd_mmio_trace_master_orig_read8;
+static sh2_read_handler *vrd_mmio_trace_master_orig_read16;
+static sh2_write_handler *vrd_mmio_trace_master_orig_write8;
+static vrd_mmio_trace_master_observer_t *vrd_mmio_trace_master_observer;
+
+/* DRC memory handlers are entered with the emulated SR live in DRC_SR_REG.
+ * Keep this trampoline in the same translation unit as the normal handlers,
+ * where DRC_DECLARE_SR reserves that host register. */
+static void REGPARM(3) vrd_mmio_trace_master_write8(
+    u32 address, u32 value, SH2 *sh2)
+{
+  unsigned int pc = sh2_pc(sh2);
+
+  DRC_SAVE_SR(sh2);
+  vrd_mmio_trace_master_orig_write8(address, value, sh2);
+  if (vrd_mmio_trace_master_observer &&
+      (address == 0x20004020 || address == 0x20004023))
+    vrd_mmio_trace_master_observer(pc, address, value & 0xff, 1, 1);
+  DRC_RESTORE_SR(sh2);
+}
+
+static u32 REGPARM(2) vrd_mmio_trace_master_read8(u32 address, SH2 *sh2)
+{
+  unsigned int pc = sh2_pc(sh2);
+  u32 value;
+
+  DRC_SAVE_SR(sh2);
+  value = vrd_mmio_trace_master_orig_read8(address, sh2);
+  if (vrd_mmio_trace_master_observer &&
+      (address == 0x20004020 || address == 0x20004023))
+    vrd_mmio_trace_master_observer(pc, address, value & 0xff, 0, 1);
+  DRC_RESTORE_SR(sh2);
+  return value;
+}
+
+static u32 REGPARM(2) vrd_mmio_trace_master_read16(u32 address, SH2 *sh2)
+{
+  unsigned int pc = sh2_pc(sh2);
+  u32 value;
+
+  DRC_SAVE_SR(sh2);
+  value = vrd_mmio_trace_master_orig_read16(address, sh2);
+  if (vrd_mmio_trace_master_observer && address == 0x20004010)
+    vrd_mmio_trace_master_observer(pc, address, value & 0xffff, 0, 2);
+  DRC_RESTORE_SR(sh2);
+  return value;
+}
+
+int Pico32xVrdMmioTraceMasterInstall(
+    vrd_mmio_trace_master_observer_t *observer)
+{
+  sh2_read_handler *current_read8, *current_read16;
+  sh2_write_handler *current_write8;
+  sh2_memmap *read8_map = (sh2_memmap *)msh2.read8_map;
+  sh2_memmap *read16_map = (sh2_memmap *)msh2.read16_map;
+
+  if (!observer || !msh2.read8_map || !msh2.read16_map || !msh2.write8_tab)
+    return 0;
+  current_read8 =
+    (sh2_read_handler *)(read8_map[0x20 / 2].addr << 1);
+  current_read16 =
+    (sh2_read_handler *)(read16_map[0x20 / 2].addr << 1);
+  current_write8 = (sh2_write_handler *)msh2.write8_tab[0x20 / 2];
+  if (current_read8 != vrd_mmio_trace_master_read8) {
+    if (!current_read8 || !current_read16 || !current_write8)
+      return 0;
+    vrd_mmio_trace_master_orig_read8 = current_read8;
+    vrd_mmio_trace_master_orig_read16 = current_read16;
+    read8_map[0x20 / 2].addr = (uptr)vrd_mmio_trace_master_read8 >> 1;
+    read16_map[0x20 / 2].addr = (uptr)vrd_mmio_trace_master_read16 >> 1;
+  }
+  if (current_write8 != vrd_mmio_trace_master_write8) {
+    vrd_mmio_trace_master_orig_write8 = current_write8;
+    msh2.write8_tab[0x20 / 2] =
+      (const void *)vrd_mmio_trace_master_write8;
+  }
+  vrd_mmio_trace_master_observer = observer;
+  return 1;
+}
+
+void Pico32xVrdMmioTraceMasterUninstall(void)
+{
+  sh2_memmap *read8_map = (sh2_memmap *)msh2.read8_map;
+  sh2_memmap *read16_map = (sh2_memmap *)msh2.read16_map;
+
+  if (msh2.read8_map &&
+      (sh2_read_handler *)(read8_map[0x20 / 2].addr << 1) ==
+        vrd_mmio_trace_master_read8) {
+    read8_map[0x20 / 2].addr =
+      (uptr)vrd_mmio_trace_master_orig_read8 >> 1;
+    read16_map[0x20 / 2].addr =
+      (uptr)vrd_mmio_trace_master_orig_read16 >> 1;
+  }
+  if (msh2.write8_tab &&
+      msh2.write8_tab[0x20 / 2] ==
+        (const void *)vrd_mmio_trace_master_write8)
+    msh2.write8_tab[0x20 / 2] =
+      (const void *)vrd_mmio_trace_master_orig_write8;
+  vrd_mmio_trace_master_observer = NULL;
+  vrd_mmio_trace_master_orig_read8 = NULL;
+  vrd_mmio_trace_master_orig_read16 = NULL;
+  vrd_mmio_trace_master_orig_write8 = NULL;
+}
+#endif
