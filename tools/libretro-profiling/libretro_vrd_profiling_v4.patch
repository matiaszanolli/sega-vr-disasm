+/* Pico32xStartup calls this immediately after rebuilding the SH2 memory maps.
+ * It is also safe at logger init when a loaded savestate already has maps. */
+void vrd_mmio_trace_attach_master(void)
+{
+    if (!vrd_mmio_trace_log || !msh2.write8_tab)
+        return;
+    /* Called either before the first retro_run for an already-loaded 32X
