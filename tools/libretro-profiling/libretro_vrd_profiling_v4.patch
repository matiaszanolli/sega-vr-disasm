+static void vrd_caller_trace_finish(int complete, int frames,
+    const char *reason)
+{
+    if (!vrd_caller_trace_log)
+        return;
+    if (complete) {
+        fprintf(vrd_caller_trace_log,
+            "# COMPLETE frames=%d hits=%u logged=%u dropped=%u errors=%u\n",
+            frames, vrd_caller_trace_hits, vrd_caller_trace_logged,
+            vrd_caller_trace_hits - vrd_caller_trace_logged,
+            vrd_caller_trace_errors);
+    } else {
+        fprintf(vrd_caller_trace_log,
+            "# INCOMPLETE frames=%d hits=%u logged=%u dropped=%u errors=%u "
+            "reason=%s\n",
+            frames, vrd_caller_trace_hits, vrd_caller_trace_logged,
+            vrd_caller_trace_hits - vrd_caller_trace_logged,
+            vrd_caller_trace_errors, reason ? reason : "unknown");
+    }
+    fflush(vrd_caller_trace_log);
+    fclose(vrd_caller_trace_log);
+    vrd_caller_trace_log = NULL;
+}
+
+static void vrd_parse_watch(const char *s) {
+    while (s && *s && vrd_watch_n < VRD_MAX_WATCH) {
+        unsigned a = 0, sz = 2;
+        if (sscanf(s, "%x:%u", &a, &sz) >= 1) {
+            vrd_watch_addr[vrd_watch_n] = a;
+            vrd_watch_size[vrd_watch_n] = sz ? sz : 2;
+            vrd_watch_n++;
+        }
+        s = strchr(s, ','); if (s) s++;
+    }
+}
+static unsigned vrd_readN(unsigned a, unsigned sz) {
+    if (sz <= 1) return vrd_r8(a);
+    if (sz == 2) return vrd_r16(a);
+    return (vrd_r16(a) << 16) | vrd_r16(a + 2);   /* 4-byte */
+}
+static void vrd_dump_regions(void) {
+    const char *path = vrd_dump_file[0] ? vrd_dump_file : "vrd_dump.txt";
+    FILE *f = fopen(path, "w");
+    const char *s = vrd_dump_spec;
+    if (!f) return;
+    while (s && *s) {
+        unsigned a = 0, len = 64, i;
+        if (sscanf(s, "%x:%u", &a, &len) >= 1) {
+            fprintf(f, "# DUMP %08X..%08X\n", a, a + len);
+            for (i = 0; i < len; i += 16) {
+                unsigned j; fprintf(f, "%08X:", a + i);
+                for (j = 0; j < 16 && i + j < len; j += 2)
+                    fprintf(f, " %04X", vrd_r16(a + i + j));
+                fprintf(f, "\n");
+            }
+        }
+        s = strchr(s, ','); if (s) s++;
+    }
+    fclose(f);
+}
