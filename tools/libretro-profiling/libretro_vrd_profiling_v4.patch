+            "# VRD_MMIO_TRACE version=2 capacity=%u sh2_drc=%d "
+            "profile_pc=%d profile_pc_env=%d m68k_batching=%s "
+            "instruction_start_hook=%d m68k_wrapped=%d "
+            "master_wrapped=%d coverage_from_start=%d pc_allowlist=%s\n",
+            VRD_MMIO_TRACE_MAX_EVENTS, sh2_drc,
+            vrd_profile_pc_enabled, vrd_profile_pc_env_present,
+            batching, vrd_instruction_hook_installed,
+            vrd_mmio_trace_m68k_installed,
+            vrd_mmio_trace_master_installed,
+            vrd_mmio_trace_coverage_from_start,
+            vrd_mmio_trace_mode1 ? VRD_MMIO_TRACE_MODE1_PC_ALLOWLIST :
+                VRD_MMIO_TRACE_PC_ALLOWLIST) < 0 ||
+        fprintf(vrd_mmio_trace_log, "%s\n",
+            vrd_mmio_trace_mode1 ?
+                "# FILTER m68k_read8=0x00A15107|0x00A15123 "
+                "m68k_read16=0x00A15110 "
+                "m68k_write16=0x00A15112 "
+                "m68k_write8=0x00A15120|0x00A15123 "
+                "master_read8=0x20004020|0x20004023 "
+                "master_read16=0x20004010 "
+                "master_write8=0x20004020|0x20004023" :
+                "# FILTER m68k_read8=0x00A15107 "
+                "m68k_write16=0x00A15112 "
+                "m68k_write8=0x00A15120|0x00A15123 "
+                "master_write8=0x20004020|0x20004023") < 0 ||
+        fprintf(vrd_mmio_trace_log,
+            "sequence,frame,cpu,pc,op,address,width,value\n") < 0 ||
+        fflush(vrd_mmio_trace_log) != 0)
