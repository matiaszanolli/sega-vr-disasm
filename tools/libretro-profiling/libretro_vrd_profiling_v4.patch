+#define VRD_MMIO_TRACE_MODE1_MASTER_PC_END   0x02303a90
+#define VRD_MMIO_TRACE_MODE1_PC_ALLOWLIST \
+    "m68k:0x0001C922-0x0001C99A;master:0x02303A10-0x02303A90"
+typedef struct {
+    unsigned int frame;
+    unsigned int pc;
+    unsigned int address;
+    unsigned int value;
+    unsigned char cpu;
+    unsigned char op;
+    unsigned char width;
+} vrd_mmio_trace_event_t;
+static vrd_mmio_trace_event_t
+    vrd_mmio_trace_buffer[VRD_MMIO_TRACE_MAX_EVENTS];
+static FILE *vrd_mmio_trace_log = NULL;
+static unsigned int vrd_mmio_trace_pc = 0;
+static unsigned int vrd_mmio_trace_count = 0;
+static unsigned long long vrd_mmio_trace_dropped = 0;
+static unsigned int vrd_mmio_trace_errors = 0;
+static int vrd_mmio_trace_overflow = 0;
+static int vrd_mmio_trace_m68k_installed = 0;
+static int vrd_mmio_trace_master_installed = 0;
+static int vrd_mmio_trace_header_written = 0;
+static int vrd_mmio_trace_coverage_from_start = 0;
+static int vrd_mmio_trace_mode1 = 0;
+static unsigned int (*vrd_mmio_trace_orig_read_byte)(unsigned int) = NULL;
+static unsigned int (*vrd_mmio_trace_orig_read_word)(unsigned int) = NULL;
+static void (*vrd_mmio_trace_orig_write_byte)(
+    unsigned int, unsigned char) = NULL;
+static void (*vrd_mmio_trace_orig_write_word)(
+    unsigned int, unsigned short) = NULL;
+static void vrd_mmio_trace_write_header(void);
+void vrd_mmio_trace_attach_master(void);
+extern int Pico32xVrdMmioTraceMasterInstall(
+    void (*observer)(unsigned int, unsigned int, unsigned int,
+        unsigned int, unsigned int));
+extern void Pico32xVrdMmioTraceMasterUninstall(void);
+
+/* One owner composes exact write-PC capture and exact caller capture.  This
+ * keeps both diagnostics on normal FAME batching and preserves any callback
+ * that was installed before VRD tracing. */
+static void vrd_instruction_start(unsigned int pc)
+{
+    if (vrd_write_trace_log)
+        vrd_write_trace_pc = pc;
+    if (vrd_mmio_trace_log)
+        vrd_mmio_trace_pc = pc;
+    if (vrd_caller_trace_log && vrd_caller_trace_addr >= 0 &&
+        (unsigned int)vrd_caller_trace_addr == pc) {
+        extern M68K_CONTEXT PicoCpuFM68k;
+        unsigned int sp = PicoCpuFM68k.areg[7].D;
+        unsigned int ret = PicoCpuFM68k.read_long(sp);
+        vrd_caller_trace_hits++;
+        if (vrd_caller_trace_max == 0 ||
+            vrd_caller_trace_logged < vrd_caller_trace_max) {
+            if (fprintf(vrd_caller_trace_log, "%d,0x%08X,0x%X,0x%X\n",
+                    vrd_profile_frame, pc, sp, ret) < 0)
+                vrd_caller_trace_errors++;
+            if (fflush(vrd_caller_trace_log) != 0)
+                vrd_caller_trace_errors++;
+            vrd_caller_trace_logged++;
+        }
+    }
+    if (vrd_instruction_orig_start)
+        vrd_instruction_orig_start(pc);
+}
+
+static void vrd_instruction_hook_install(void)
+{
+    if (vrd_instruction_hook_installed ||
+        (!vrd_write_trace_log && !vrd_caller_trace_log &&
+         !vrd_mmio_trace_log))
+        return;
+    vrd_instruction_orig_start = PicoCpuFM68k.instruction_start;
+    PicoCpuFM68k.instruction_start = vrd_instruction_start;
+    vrd_instruction_hook_installed = 1;
+}
+
+static void vrd_instruction_hook_uninstall(void)
+{
+    if (!vrd_instruction_hook_installed)
+        return;
+    PicoCpuFM68k.instruction_start = vrd_instruction_orig_start;
+    vrd_instruction_orig_start = NULL;
+    vrd_instruction_hook_installed = 0;
+}
+
+static void vrd_write_trace_error(const char *message)
+{
+    if (log_cb)
+        log_cb(RETRO_LOG_ERROR, "VRD_WRITE_TRACE: %s\n", message);
+    else
+        printf("VRD_WRITE_TRACE: %s\n", message);
+}
+
+static int vrd_write_trace_parse(const char *spec)
+{
+    const char *p = spec;
+
+    vrd_write_trace_target_count = 0;
+    while (p && *p) {
+        char *end;
+        unsigned long addr, size;
+        int i;
+
+        if (vrd_write_trace_target_count >= VRD_WRITE_TRACE_MAX_TARGETS) {
+            vrd_write_trace_error("too many targets");
+            return 0;
+        }
+        errno = 0;
+        addr = strtoul(p, &end, 0);
+        if (errno || end == p || *end != ':') {
+            vrd_write_trace_error("invalid target address; expected addr:size");
+            return 0;
+        }
+        p = end + 1;
+        errno = 0;
+        size = strtoul(p, &end, 0);
+        if (errno || end == p || (size != 1 && size != 2 && size != 4) ||
+            addr > 0x00ffffffUL || addr + size > 0x01000000UL) {
+            vrd_write_trace_error("invalid target size/range; size must be 1, 2, or 4");
+            return 0;
+        }
+        for (i = 0; i < vrd_write_trace_target_count; i++) {
+            if (vrd_write_trace_targets[i].addr == (unsigned int)addr &&
+                vrd_write_trace_targets[i].size == (unsigned int)size) {
+                vrd_write_trace_error("duplicate target");
+                return 0;
+            }
+        }
+        vrd_write_trace_targets[vrd_write_trace_target_count].addr =
+            (unsigned int)addr;
+        vrd_write_trace_targets[vrd_write_trace_target_count].size =
+            (unsigned int)size;
+        vrd_write_trace_target_count++;
+        if (*end == '\0')
+            break;
+        if (*end != ',' || end[1] == '\0') {
+            vrd_write_trace_error("invalid target separator; expected comma");
+            return 0;
+        }
+        p = end + 1;
+    }
+
+    if (vrd_write_trace_target_count == 0) {
+        vrd_write_trace_error("empty target list");
+        return 0;
+    }
+    return 1;
+}
+
+static int vrd_write_trace_has_target(unsigned int addr, unsigned int size)
+{
+    int i;
+    for (i = 0; i < vrd_write_trace_target_count; i++) {
+        if (vrd_write_trace_targets[i].addr == addr &&
+            vrd_write_trace_targets[i].size == size)
+            return 1;
+    }
+    return 0;
+}
+
+static unsigned int vrd_write_trace_read_target(int target)
+{
+    unsigned int value = 0;
+    unsigned int i;
+    for (i = 0; i < vrd_write_trace_targets[target].size; i++) {
+        value = (value << 8) |
+            (PicoCpuFM68k.read_byte(
+                vrd_write_trace_targets[target].addr + i) & 0xff);
+    }
+    return value;
+}
+
+static unsigned int vrd_write_trace_collect(unsigned int access_addr,
+    unsigned int access_size, unsigned int *old_values)
+{
+    unsigned int matches = 0;
+    int i;
+
+    for (i = 0; i < vrd_write_trace_target_count; i++) {
+        unsigned int target_addr = vrd_write_trace_targets[i].addr;
+        unsigned int target_size = vrd_write_trace_targets[i].size;
+        if (access_addr < target_addr + target_size &&
+            target_addr < access_addr + access_size) {
+            old_values[i] = vrd_write_trace_read_target(i);
+            matches |= 1u << i;
+        }
+    }
+    return matches;
+}
+
+static void vrd_write_trace_log_matches(unsigned int matches,
+    unsigned int access_addr, unsigned int access_size,
+    const unsigned int *old_values)
+{
+    int i;
+
+    for (i = 0; i < vrd_write_trace_target_count; i++) {
+        unsigned int new_value;
+        int digits;
+        if (!(matches & (1u << i)))
+            continue;
+        new_value = vrd_write_trace_read_target(i);
+        digits = (int)vrd_write_trace_targets[i].size * 2;
+        if (fprintf(vrd_write_trace_log,
+                "%d,0x%06X,0x%06X,%u,0x%06X,%u,0x%0*X,0x%0*X\n",
+                vrd_profile_frame, vrd_write_trace_pc,
+                vrd_write_trace_targets[i].addr,
+                vrd_write_trace_targets[i].size,
+                access_addr, access_size, digits, old_values[i],
+                digits, new_value) < 0) {
+            vrd_write_trace_errors++;
+        }
+        vrd_write_trace_events++;
+    }
+    if (fflush(vrd_write_trace_log) != 0)
+        vrd_write_trace_errors++;
+}
+
+static void vrd_write_trace_byte(unsigned int addr, unsigned char data)
+{
+    unsigned int old_values[VRD_WRITE_TRACE_MAX_TARGETS];
+    unsigned int effective_addr = addr & 0x00ffffff;
+    unsigned int matches = vrd_write_trace_collect(effective_addr, 1, old_values);
+    vrd_write_trace_orig_byte(addr, data);
+    if (matches)
+        vrd_write_trace_log_matches(matches, effective_addr, 1, old_values);
+}
+
+static void vrd_write_trace_word(unsigned int addr, unsigned short data)
+{
+    unsigned int old_values[VRD_WRITE_TRACE_MAX_TARGETS];
+    unsigned int effective_addr = addr & 0x00fffffe;
+    unsigned int matches = vrd_write_trace_collect(effective_addr, 2, old_values);
+    vrd_write_trace_orig_word(addr, data);
+    if (matches)
+        vrd_write_trace_log_matches(matches, effective_addr, 2, old_values);
+}
+
+static void vrd_write_trace_long(unsigned int addr, unsigned int data)
+{
+    unsigned int old_values[VRD_WRITE_TRACE_MAX_TARGETS];
+    unsigned int effective_addr = addr & 0x00fffffe;
+    unsigned int matches = vrd_write_trace_collect(effective_addr, 4, old_values);
+    vrd_write_trace_orig_long(addr, data);
+    if (matches)
+        vrd_write_trace_log_matches(matches, effective_addr, 4, old_values);
+}
+
+static void vrd_write_trace_uninstall(void)
+{
+    if (!vrd_write_trace_installed)
+        return;
+    PicoCpuFM68k.write_byte = vrd_write_trace_orig_byte;
+    PicoCpuFM68k.write_word = vrd_write_trace_orig_word;
+    PicoCpuFM68k.write_long = vrd_write_trace_orig_long;
+    vrd_write_trace_installed = 0;
+}
+
+static void vrd_write_trace_finish(int complete, int frames,
+    const char *reason)
+{
+    if (vrd_write_trace_log) {
+        if (complete) {
+            fprintf(vrd_write_trace_log,
+                "# COMPLETE frames=%d events=%llu errors=%u\n",
+                frames, vrd_write_trace_events, vrd_write_trace_errors);
+        } else {
+            fprintf(vrd_write_trace_log,
+                "# INCOMPLETE frames=%d events=%llu errors=%u reason=%s\n",
+                frames, vrd_write_trace_events, vrd_write_trace_errors,
+                reason ? reason : "unknown");
+        }
+        fflush(vrd_write_trace_log);
+        fclose(vrd_write_trace_log);
+        vrd_write_trace_log = NULL;
+    }
+    vrd_write_trace_uninstall();
+}
+
+static void vrd_write_trace_init(const char *spec, const char *path)
+{
+    if (!spec || !*spec)
+        return;
+    if (!path || !*path) {
+        vrd_write_trace_error("VRD_WRITE_TRACE_LOG is required");
+        return;
+    }
+    if (!vrd_write_trace_parse(spec))
+        return;
+    if (!vrd_write_trace_has_target(0x00ffc87e, 2) ||
+        !vrd_write_trace_has_target(0x00ff0002, 4)) {
+        vrd_write_trace_error(
+            "required targets are 0xFFC87E:2 and 0xFF0002:4");
+        return;
+    }
+    if (filestream_exists(path)) {
+        char message[256];
+        snprintf(message, sizeof(message),
+            "refusing to overwrite existing trace log %s", path);
+        vrd_write_trace_error(message);
+        return;
+    }
+    vrd_write_trace_log = fopen(path, "w");
+    if (!vrd_write_trace_log) {
+        char message[256];
+        snprintf(message, sizeof(message), "cannot create %s: %s",
+            path, strerror(errno));
+        vrd_write_trace_error(message);
+        return;
+    }
+    vrd_write_trace_orig_byte = PicoCpuFM68k.write_byte;
+    vrd_write_trace_orig_word = PicoCpuFM68k.write_word;
+    vrd_write_trace_orig_long = PicoCpuFM68k.write_long;
+    if (!vrd_write_trace_orig_byte || !vrd_write_trace_orig_word ||
+        !vrd_write_trace_orig_long) {
+        vrd_write_trace_error("68K memory callbacks are not initialized");
+        vrd_write_trace_finish(0, 0, "callbacks_unavailable");
+        return;
+    }
+    PicoCpuFM68k.write_byte = vrd_write_trace_byte;
+    PicoCpuFM68k.write_word = vrd_write_trace_word;
+    PicoCpuFM68k.write_long = vrd_write_trace_long;
+    vrd_write_trace_installed = 1;
+}
+
+enum {
+    VRD_MMIO_CPU_M68K = 0,
+    VRD_MMIO_CPU_MASTER = 1,
+    VRD_MMIO_OP_READ = 0,
+    VRD_MMIO_OP_WRITE = 1
+};
+
+static void vrd_mmio_trace_error(const char *message)
+{
+    if (log_cb)
+        log_cb(RETRO_LOG_ERROR, "VRD_MMIO_TRACE: %s\n", message);
+    else
+        printf("VRD_MMIO_TRACE: %s\n", message);
+}
+
+static void vrd_mmio_trace_append(unsigned int cpu, unsigned int pc,
+    unsigned int op, unsigned int address, unsigned int width,
+    unsigned int value)
+{
+    vrd_mmio_trace_event_t *event;
+    int pc_allowed = vrd_mmio_trace_mode1 ?
+        ((cpu == VRD_MMIO_CPU_M68K &&
+          pc >= VRD_MMIO_TRACE_MODE1_M68K_PC_START &&
+          pc < VRD_MMIO_TRACE_MODE1_M68K_PC_END) ||
+         (cpu == VRD_MMIO_CPU_MASTER &&
+          pc >= VRD_MMIO_TRACE_MODE1_MASTER_PC_START &&
+          pc < VRD_MMIO_TRACE_MODE1_MASTER_PC_END)) :
+        ((cpu == VRD_MMIO_CPU_M68K &&
+          pc >= VRD_MMIO_TRACE_M68K_PC_START &&
+          pc < VRD_MMIO_TRACE_M68K_PC_END) ||
+         (cpu == VRD_MMIO_CPU_MASTER &&
+          pc >= VRD_MMIO_TRACE_MASTER_PC_START &&
+          pc < VRD_MMIO_TRACE_MASTER_PC_END));
+
+    if (!pc_allowed)
+        return;
+    if (vrd_mmio_trace_count >= VRD_MMIO_TRACE_MAX_EVENTS) {
+        vrd_mmio_trace_dropped++;
+        vrd_mmio_trace_overflow = 1;
+        return;
+    }
+    event = &vrd_mmio_trace_buffer[vrd_mmio_trace_count++];
+    event->frame = (unsigned int)vrd_profile_frame;
+    event->pc = pc;
+    event->address = address;
+    event->value = value;
+    event->cpu = (unsigned char)cpu;
+    event->op = (unsigned char)op;
+    event->width = (unsigned char)width;
+}
+
+static unsigned int vrd_mmio_trace_read_byte(unsigned int address)
+{
+    unsigned int value = vrd_mmio_trace_orig_read_byte(address);
+    unsigned int effective_address = address & 0x00ffffff;
+
+    if (effective_address == 0x00a15107 ||
+        (vrd_mmio_trace_mode1 && effective_address == 0x00a15123))
+        vrd_mmio_trace_append(VRD_MMIO_CPU_M68K, vrd_mmio_trace_pc,
+            VRD_MMIO_OP_READ, effective_address, 1, value & 0xff);
+    return value;
+}
+
+static unsigned int vrd_mmio_trace_read_word(unsigned int address)
+{
+    unsigned int value = vrd_mmio_trace_orig_read_word(address);
+    unsigned int effective_address = address & 0x00fffffe;
+
+    if (vrd_mmio_trace_mode1 && effective_address == 0x00a15110)
+        vrd_mmio_trace_append(VRD_MMIO_CPU_M68K, vrd_mmio_trace_pc,
+            VRD_MMIO_OP_READ, effective_address, 2, value & 0xffff);
+    return value;
+}
+
+static void vrd_mmio_trace_write_byte(
+    unsigned int address, unsigned char value)
+{
+    unsigned int effective_address = address & 0x00ffffff;
+
+    vrd_mmio_trace_orig_write_byte(address, value);
+    if (effective_address == 0x00a15120 ||
+        effective_address == 0x00a15123)
+        vrd_mmio_trace_append(VRD_MMIO_CPU_M68K, vrd_mmio_trace_pc,
+            VRD_MMIO_OP_WRITE, effective_address, 1, value);
+}
+
+static void vrd_mmio_trace_write_word(
+    unsigned int address, unsigned short value)
+{
+    unsigned int effective_address = address & 0x00fffffe;
+
+    vrd_mmio_trace_orig_write_word(address, value);
+    if (effective_address == 0x00a15112)
+        vrd_mmio_trace_append(VRD_MMIO_CPU_M68K, vrd_mmio_trace_pc,
+            VRD_MMIO_OP_WRITE, effective_address, 2, value);
+}
+
+void vrd_mmio_trace_master_event(
+    unsigned int pc, unsigned int address, unsigned int value,
+    unsigned int op, unsigned int width)
+{
+    vrd_mmio_trace_append(VRD_MMIO_CPU_MASTER, pc,
+        op, address, width, value);
+}
+
+static void vrd_mmio_trace_uninstall(void)
+{
+    if (vrd_mmio_trace_m68k_installed) {
+        PicoCpuFM68k.read_byte = vrd_mmio_trace_orig_read_byte;
+        PicoCpuFM68k.read_word = vrd_mmio_trace_orig_read_word;
+        PicoCpuFM68k.write_byte = vrd_mmio_trace_orig_write_byte;
+        PicoCpuFM68k.write_word = vrd_mmio_trace_orig_write_word;
+        vrd_mmio_trace_m68k_installed = 0;
+    }
+    if (vrd_mmio_trace_master_installed) {
+        Pico32xVrdMmioTraceMasterUninstall();
+        vrd_mmio_trace_master_installed = 0;
+    }
+}
+
+static void vrd_mmio_trace_finish(int complete, int frames,
+    const char *reason)
+{
+    unsigned int i;
+    unsigned long long total;
+
+    if (!vrd_mmio_trace_log) {
+        vrd_mmio_trace_uninstall();
+        return;
+    }
+    if (!vrd_mmio_trace_header_written) {
+        vrd_mmio_trace_write_header();
+        complete = 0;
+        reason = "master_callback_unavailable";
+    }
+    if (!vrd_mmio_trace_coverage_from_start) {
+        complete = 0;
+        if (!reason)
+            reason = "coverage_started_late";
+    }
+    vrd_mmio_trace_uninstall();
+    for (i = 0; i < vrd_mmio_trace_count; i++) {
+        const vrd_mmio_trace_event_t *event = &vrd_mmio_trace_buffer[i];
+        const char *cpu = event->cpu == VRD_MMIO_CPU_M68K ?
+            "m68k" : "master";
+        const char *op = event->op == VRD_MMIO_OP_READ ? "read" : "write";
+        if (fprintf(vrd_mmio_trace_log,
+                "%u,%u,%s,0x%08X,%s,0x%08X,%u,0x%X\n",
+                i, event->frame, cpu, event->pc, op, event->address,
+                event->width, event->value) < 0)
+            vrd_mmio_trace_errors++;
+    }
+    if (fflush(vrd_mmio_trace_log) != 0)
+        vrd_mmio_trace_errors++;
+    total = (unsigned long long)vrd_mmio_trace_count +
+        vrd_mmio_trace_dropped;
+    if (complete && !vrd_mmio_trace_overflow &&
+        vrd_mmio_trace_dropped == 0 && vrd_mmio_trace_errors == 0) {
+        fprintf(vrd_mmio_trace_log,
+            "# COMPLETE frames=%d events=%llu recorded=%u dropped=%llu "
+            "errors=%u overflow=%d pc_allowlist=%s\n",
+            frames, total, vrd_mmio_trace_count, vrd_mmio_trace_dropped,
+            vrd_mmio_trace_errors, vrd_mmio_trace_overflow,
+            vrd_mmio_trace_mode1 ? VRD_MMIO_TRACE_MODE1_PC_ALLOWLIST :
+                VRD_MMIO_TRACE_PC_ALLOWLIST);
+    } else {
+        fprintf(vrd_mmio_trace_log,
+            "# INCOMPLETE frames=%d events=%llu recorded=%u dropped=%llu "
+            "errors=%u overflow=%d pc_allowlist=%s reason=%s\n",
+            frames, total, vrd_mmio_trace_count, vrd_mmio_trace_dropped,
+            vrd_mmio_trace_errors, vrd_mmio_trace_overflow,
+            vrd_mmio_trace_mode1 ? VRD_MMIO_TRACE_MODE1_PC_ALLOWLIST :
+                VRD_MMIO_TRACE_PC_ALLOWLIST,
+            reason ? reason :
+                (vrd_mmio_trace_overflow ? "overflow" : "logger_error"));
+    }
+    fflush(vrd_mmio_trace_log);
+    fclose(vrd_mmio_trace_log);
+    vrd_mmio_trace_log = NULL;
+}
+
+static void vrd_mmio_trace_init(const char *enabled, const char *path)
+{
+    const char *mode;
+    if (!enabled)
+        return;
+    if (strcmp(enabled, "1") != 0) {
+        vrd_mmio_trace_error("VRD_MMIO_TRACE must be exactly 1");
+        return;
+    }
+    if (!path || !*path) {
+        vrd_mmio_trace_error("VRD_MMIO_TRACE_LOG is required");
+        return;
+    }
+    mode = getenv("VRD_MMIO_TRACE_MODE");
+    if (mode && strcmp(mode, "mode1") != 0) {
+        vrd_mmio_trace_error("VRD_MMIO_TRACE_MODE must be exactly mode1");
+        return;
+    }
+    vrd_mmio_trace_mode1 = mode != NULL;
+    if (filestream_exists(path)) {
+        char message[256];
+        snprintf(message, sizeof(message),
+            "refusing to overwrite existing trace log %s", path);
+        vrd_mmio_trace_error(message);
+        return;
+    }
+    vrd_mmio_trace_count = 0;
+    vrd_mmio_trace_dropped = 0;
+    vrd_mmio_trace_errors = 0;
+    vrd_mmio_trace_overflow = 0;
+    vrd_mmio_trace_pc = 0;
+    vrd_mmio_trace_m68k_installed = 0;
+    vrd_mmio_trace_master_installed = 0;
+    vrd_mmio_trace_header_written = 0;
+    vrd_mmio_trace_coverage_from_start = 0;
+    vrd_mmio_trace_log = fopen(path, "w");
+    if (!vrd_mmio_trace_log) {
+        char message[256];
+        snprintf(message, sizeof(message), "cannot create %s: %s",
+            path, strerror(errno));
+        vrd_mmio_trace_error(message);
+        return;
+    }
+    vrd_mmio_trace_orig_read_byte = PicoCpuFM68k.read_byte;
+    vrd_mmio_trace_orig_read_word = PicoCpuFM68k.read_word;
+    vrd_mmio_trace_orig_write_byte = PicoCpuFM68k.write_byte;
+    vrd_mmio_trace_orig_write_word = PicoCpuFM68k.write_word;
