+/* Stable, read-only debugger ABI for the repository's headless frontend.
+ * Keep this independent of SH2's internal layout so frontend and core can
+ * validate their ABI explicitly. CPU ids: 0=68K, 1=Master SH2, 2=Slave SH2. */
+struct vrd_debug_sh2_regs {
+    u32 r[16];
+    u32 pc, pr, sr, gbr, vbr, mach, macl;
+    u32 state, poll_addr;
+    int poll_cnt;
+};
+
+unsigned vrd_debug_abi_version(void)
+{
+    return 1;
+}
+
+size_t vrd_debug_sh2_regs_size(void)
+{
+    return sizeof(struct vrd_debug_sh2_regs);
+}
+
+int vrd_debug_get_sh2_regs(unsigned cpu_id, struct vrd_debug_sh2_regs *out)
+{
+    SH2 *sh2;
+
+    if (!out || !(PicoIn.AHW & PAHW_32X) || (cpu_id != 1 && cpu_id != 2))
+        return 0;
+    sh2 = cpu_id == 1 ? &msh2 : &ssh2;
+    memcpy(out->r, sh2->r, sizeof(out->r));
+    out->pc = sh2->pc;
+    out->pr = sh2->pr;
+    out->sr = sh2->sr;
+    out->gbr = sh2->gbr;
+    out->vbr = sh2->vbr;
+    out->mach = sh2->mach;
+    out->macl = sh2->macl;
+    out->state = sh2->state;
+    out->poll_addr = sh2->poll_addr;
+    out->poll_cnt = sh2->poll_cnt;
+    return 1;
+}
+
+int vrd_debug_read(unsigned cpu_id, u32 addr, void *data, size_t size)
+{
+    unsigned char *out = data;
+    size_t i;
+
+    if (!out || size == 0 || cpu_id > 2)
+        return 0;
+    if (cpu_id != 0 && !(PicoIn.AHW & PAHW_32X))
+        return 0;
+    for (i = 0; i < size; i++) {
+        if (cpu_id == 0)
+            out[i] = PicoCpuFM68k.read_byte((addr + (u32)i) & 0x00ffffff);
+        else
+            out[i] = p32x_sh2_read8(addr + (u32)i,
+                cpu_id == 1 ? &msh2 : &ssh2);
+    }
+    return 1;
+}
+
+/* Generic read routed to the right bus: 68K (ROM/WRAM) vs SH2 (FB/SDRAM/etc). */
+static unsigned vrd_r16(unsigned addr) {
+    extern M68K_CONTEXT PicoCpuFM68k;
+    if (addr < 0x400000 || (addr >= 0xFF0000 && addr <= 0xFFFFFF))
+        return PicoCpuFM68k.read_word(addr) & 0xFFFF;
+    return p32x_sh2_read16(addr, &msh2) & 0xFFFF;
+}
+static unsigned vrd_r8(unsigned addr) {
+    extern M68K_CONTEXT PicoCpuFM68k;
+    if (addr < 0x400000 || (addr >= 0xFF0000 && addr <= 0xFFFFFF))
+        return PicoCpuFM68k.read_byte(addr) & 0xFF;
+    return p32x_sh2_read8(addr, &msh2) & 0xFF;
+}
