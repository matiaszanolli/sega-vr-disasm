/* Q-028 validation-only all-access observer.
 *
 * This file is included by the fail-closed PicoDrive overlay generated by
 * prepare_q028_picodrive.py.  It never changes emulated memory or scheduling.
 * The callbacks are deliberately synchronous and filter only after every
 * backend has reported the completed access.
 */

#define VRD_Q028_OBSERVER_VERSION 6
#define VRD_Q028_CODE_START 0x0600bbc0u
#define VRD_Q028_CODE_END   0x0600bce8u
#define VRD_Q028_STACK_START 0x0600f180u
#define VRD_Q028_STACK_END   0x06010000u

enum {
    VRD_Q028_AGENT_NONE = 0,
    VRD_Q028_AGENT_IDL,
    VRD_Q028_AGENT_M_DMAC0,
    VRD_Q028_AGENT_M_DMAC1,
    VRD_Q028_AGENT_S_DMAC0,
    VRD_Q028_AGENT_S_DMAC1,
    VRD_Q028_AGENT_M_DREQ0,
    VRD_Q028_AGENT_S_DREQ0,
    VRD_Q028_AGENT_M_DREQ1,
    VRD_Q028_AGENT_S_DREQ1,
    VRD_Q028_AGENT_BRIDGE,
};

