static const char *vrd_q028_agent_name(unsigned int agent)
{
    static const char *const names[] = {
        "none", "idl", "master_dmac0", "master_dmac1",
        "slave_dmac0", "slave_dmac1", "master_dreq0",
        "slave_dreq0", "master_dreq1", "slave_dreq1", "bridge"
    };
    return agent < sizeof(names) / sizeof(names[0]) ? names[agent] : "unknown";
}

static unsigned int vrd_q028_normalize(unsigned int raw, unsigned int cpu,
    const char **space)
{
    unsigned int a = raw;
    if (cpu == 0 && (a & 0x00ffffffu) >= 0x00ff6000u &&
        (a & 0x00ffffffu) < 0x00ff6a00u) {
        *space = "wram";
        return a & 0x00ffffffu;
    }
    if (cpu == 0 && a >= 0x008abbc0 && a < 0x008abce8) {
        *space = "rom";
        return 0x02000000u + (a - 0x00880000u);
    }
    if (cpu != 0 && (a & 0xdfffffffu) >= 0x0202bbc0u &&
        (a & 0xdfffffffu) < 0x0202bce8u) {
        *space = "rom";
        return a & 0xdfffffffu;
    }
    if (cpu != 0 && (a & 0xdfffffffu) >= VRD_Q028_CODE_START &&
        (a & 0xdfffffffu) < VRD_Q028_STACK_END) {
        *space = "sdram";
        return a & 0xdfffffffu;
    }
    *space = "other";
    return a;
}

static int vrd_q028_overlaps(unsigned int a, unsigned int width,
    unsigned int lo, unsigned int hi)
{
    unsigned long long end = (unsigned long long)a + width;
    return width != 0 && a < hi && end > lo;
}

static int vrd_q028_descriptor_overlap(unsigned int a, unsigned int width)
{
    unsigned int i, g, base, count;
    if (vrd_q028_family == 1) {
        base = 0x0600c128; count = 4;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14, base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 2) {
        base = 0x0600c178; count = 8;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14, base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 3) {
        for (g = 0; g < 7; g++)
            for (i = 0; i < 3; i++) {
                base = 0x0600c254 + g * 0x78 + i * 0x14;
                if (vrd_q028_overlaps(a, width, base, base + 2))
                    return 1;
            }
    }
    return 0;
}

static int vrd_q028_source_overlap(unsigned int a, unsigned int width)
{
    unsigned int i, g, base, count;
    if (vrd_q028_family == 1) {
        base = 0x00ff6128; count = 4;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14,
                    base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 2) {
        base = 0x00ff6178; count = 8;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14,
                    base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 3) {
        for (g = 0; g < 7; g++)
            for (i = 0; i < 3; i++) {
                base = 0x00ff6254 + g * 0x78 + i * 0x14;
                if (vrd_q028_overlaps(a, width, base, base + 2))
                    return 1;
            }
    }
    return 0;
}

static int vrd_q028_watched(unsigned int normalized, unsigned int width)
{
    return vrd_q028_overlaps(normalized, width, 0x0202bbc0, 0x0202bce8) ||
        vrd_q028_overlaps(normalized, width, VRD_Q028_CODE_START, VRD_Q028_CODE_END) ||
        vrd_q028_descriptor_overlap(normalized, width) ||
        vrd_q028_source_overlap(normalized, width) ||
        vrd_q028_overlaps(normalized, width, VRD_Q028_STACK_START, VRD_Q028_STACK_END) ||
        vrd_q028_overlaps(normalized, width, 0x20004006, 0x20004008) ||
        vrd_q028_overlaps(normalized, width, 0x20004010, 0x20004012);
}

static void vrd_q028_event(unsigned int cpu, const char *kind,
    unsigned int pc, unsigned int raw, unsigned int width,
    unsigned int value, const char *op)
{
    const char *space;
    unsigned int normalized, irq_depth = 0;
    const char *agent;

    if (!vrd_q028_log)
        return;
    if (width != 1 && width != 2 && width != 4) {
        vrd_q028_unknown++;
        return;
    }
    normalized = vrd_q028_normalize(raw, cpu, &space);
    if (vrd_q028_overlaps(normalized, width,
            VRD_Q028_STACK_START, VRD_Q028_STACK_END) &&
        (cpu != 2 || !vrd_q028_cmd02_active ||
         !((pc >= 0x0600bbc0 && pc < 0x0600bcc0) ||
           (pc >= 0x060024dc && pc < 0x06002508))))
        return;
    if (!vrd_q028_watched(normalized, width))
        return;
    if (cpu == 1 || cpu == 2)
        irq_depth = vrd_q028_irq_depth[cpu - 1];
    if (vrd_q028_agent != VRD_Q028_AGENT_NONE)
        agent = vrd_q028_agent_name(vrd_q028_agent);
    else
        agent = cpu == 0 ? "m68k" : (cpu == 1 ? "master" :
            (cpu == 2 ? "slave" : "unknown"));
    if (cpu > 2 || !strcmp(agent, "unknown"))
        vrd_q028_unknown++;
    if (width == 1) value &= 0xff;
    else if (width == 2) value &= 0xffff;
    if (fprintf(vrd_q028_log,
            "%llu,%d,%llu,%s,%s,0x%08X,%u,%s,0x%08X,0x%08X,%s,%u,0x%08X\n",
            vrd_q028_sequence, vrd_profile_frame, vrd_q028_sequence,
            agent, kind, pc, irq_depth, op, raw, normalized, space, width,
            value) < 0)
        vrd_q028_errors++;
    vrd_q028_sequence++;
    vrd_q028_events++;
}

static void vrd_q028_image(const char *label, unsigned int pc)
{
    unsigned int i;
    const unsigned char *bytes;
    if (!vrd_q028_log || !Pico32xMem)
        return;
    bytes = Pico32xMem->sdram + 0xbbc0;
    if (fprintf(vrd_q028_log,
            "# IMAGE sequence=%llu frame=%d label=%s pc=0x%08X bytes=",
            vrd_q028_sequence, vrd_profile_frame, label, pc) < 0) {
        vrd_q028_errors++;
        return;
    }
    for (i = 0; i < 296; i++)
        if (fprintf(vrd_q028_log, "%02X", bytes[i]) < 0) {
            vrd_q028_errors++;
            break;
        }
    if (fputc('\n', vrd_q028_log) == EOF)
        vrd_q028_errors++;
}

void vrd_q028_idl_count(unsigned int is_write, unsigned int address,
    unsigned int width);

void vrd_q028_m68k_fetch(unsigned int address, unsigned int width,
    unsigned int value)
{
    vrd_q028_event(0, "fetch", address, address, width, value, "read");
}

void vrd_q028_m68k_instruction(unsigned int pc)
{
    /* FAME exposes every opcode PC before its direct mapped fetch.  The opcode
     * word is exact; the ten-byte conservative span is the architectural
     * maximum instruction length and makes an extension overlap fail closed. */
    vrd_q028_event(0, "fetch", pc, pc, 2, 0, "read");
    if (vrd_q028_log && pc < 0x008abce8 &&
        (unsigned long long)pc + 10 > 0x008abbc0) {
        if (fprintf(vrd_q028_log,
                "# M68K_FETCH_SPAN pc=0x%08X width=10 outcome=forbidden\n",
                pc) < 0)
            vrd_q028_errors++;
        vrd_q028_unknown++;
    }
}

static unsigned int vrd_q028_read_byte(unsigned int address)
{
    unsigned int value = vrd_q028_orig_read_byte(address);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 1, value, "read");
    return value;
}

static unsigned int vrd_q028_read_word(unsigned int address)
{
    unsigned int value = vrd_q028_orig_read_word(address);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 2, value, "read");
    return value;
}

static unsigned int vrd_q028_read_long(unsigned int address)
{
    unsigned int value = vrd_q028_orig_read_long(address);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 4, value, "read");
    return value;
}

static void vrd_q028_m68k_source_context(unsigned int address,
    unsigned int width, unsigned int value);

static void vrd_q028_write_byte(unsigned int address, unsigned char value)
{
    vrd_q028_orig_write_byte(address, value);
    if (vrd_q028_command_log && (address & 0x00ffffffu) == 0x00a15121u &&
        value == 0x02) {
        vrd_q028_command_ordinal++;
        vrd_q028_cmd_byte_pending = 1;
        if (fprintf(vrd_q028_command_log,
                "%u,%d,cmd02,m68k,0x%08X,0x%08X,1,0x%02X,%u\n",
                vrd_q028_command_ordinal, vrd_profile_frame,
                vrd_mmio_trace_pc, address, value,
                (PicoIn.opt & POPT_EN_DRC) != 0) < 0)
            vrd_q028_errors++;
    }
    else if (vrd_q028_command_log &&
        (address & 0x00ffffffu) == 0x00a15120u && value == 0x01) {
        if (!vrd_q028_cmd_byte_pending)
            vrd_q028_errors++;
        vrd_q028_cmd_byte_pending = 0;
        if (fprintf(vrd_q028_command_log,
                "%u,%d,submit,m68k,0x%08X,0x%08X,1,0x%02X,%u\n",
                vrd_q028_command_ordinal, vrd_profile_frame,
                vrd_mmio_trace_pc, address, value,
                (PicoIn.opt & POPT_EN_DRC) != 0) < 0)
            vrd_q028_errors++;
    }
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 1, value, "write");
    vrd_q028_m68k_source_context(address, 1, value);
}

static void vrd_q028_m68k_source_context(unsigned int address,
    unsigned int width, unsigned int value)
{
    unsigned int i, sp, ret;
    extern M68K_CONTEXT PicoCpuFM68k;
    if (!vrd_q028_log || !vrd_q028_source_overlap(address & 0x00ffffffu,
            width))
        return;
    sp = PicoCpuFM68k.areg[7].D;
    ret = vrd_q028_orig_read_long(sp);
    if (fprintf(vrd_q028_log,
            "# M68K_SOURCE_CONTEXT sequence=%llu frame=%d pc=0x%08X "
            "address=0x%08X width=%u value=0x%08X sp=0x%08X "
            "caller=0x%08X",
            vrd_q028_sequence, vrd_profile_frame, vrd_mmio_trace_pc,
            address, width, value, sp, ret) < 0) {
        vrd_q028_errors++;
        return;
    }
    for (i = 0; i < 8; i++)
        if (fprintf(vrd_q028_log, " d%u=0x%08X", i,
                PicoCpuFM68k.dreg[i].D) < 0)
            vrd_q028_errors++;
    for (i = 0; i < 8; i++)
        if (fprintf(vrd_q028_log, " a%u=0x%08X", i,
                PicoCpuFM68k.areg[i].D) < 0)
            vrd_q028_errors++;
    if (fputc('\n', vrd_q028_log) == EOF)
        vrd_q028_errors++;
}

static void vrd_q028_write_word(unsigned int address, unsigned short value)
{
    vrd_q028_orig_write_word(address, value);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 2, value, "write");
    vrd_q028_m68k_source_context(address, 2, value);
}

static void vrd_q028_write_long(unsigned int address, unsigned int value)
{
    vrd_q028_orig_write_long(address, value);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 4, value, "write");
    vrd_q028_m68k_source_context(address, 4, value);
}

static void vrd_q028_m68k_install(void)
{
    if ((!vrd_q028_log && !vrd_q028_command_log) || vrd_q028_m68k_installed)
        return;
    vrd_q028_orig_read_byte = PicoCpuFM68k.read_byte;
    vrd_q028_orig_read_word = PicoCpuFM68k.read_word;
    vrd_q028_orig_read_long = PicoCpuFM68k.read_long;
    vrd_q028_orig_write_byte = PicoCpuFM68k.write_byte;
    vrd_q028_orig_write_word = PicoCpuFM68k.write_word;
    vrd_q028_orig_write_long = PicoCpuFM68k.write_long;
    PicoCpuFM68k.read_byte = vrd_q028_read_byte;
    PicoCpuFM68k.read_word = vrd_q028_read_word;
    PicoCpuFM68k.read_long = vrd_q028_read_long;
    PicoCpuFM68k.write_byte = vrd_q028_write_byte;
    PicoCpuFM68k.write_word = vrd_q028_write_word;
    PicoCpuFM68k.write_long = vrd_q028_write_long;
    vrd_q028_m68k_installed = 1;
}

static void vrd_q028_m68k_uninstall(void)
{
    if (!vrd_q028_m68k_installed)
        return;
    PicoCpuFM68k.read_byte = vrd_q028_orig_read_byte;
    PicoCpuFM68k.read_word = vrd_q028_orig_read_word;
    PicoCpuFM68k.read_long = vrd_q028_orig_read_long;
    PicoCpuFM68k.write_byte = vrd_q028_orig_write_byte;
    PicoCpuFM68k.write_word = vrd_q028_orig_write_word;
    PicoCpuFM68k.write_long = vrd_q028_orig_write_long;
    vrd_q028_m68k_installed = 0;
}

unsigned int vrd_q028_bus_begin(unsigned int agent)
{
    unsigned int previous = vrd_q028_agent;
    if (vrd_q028_log) {
        if (agent <= VRD_Q028_AGENT_NONE || agent > VRD_Q028_AGENT_BRIDGE)
            vrd_q028_unknown++;
        else if (vrd_q028_agent == VRD_Q028_AGENT_NONE)
            vrd_q028_agent = agent;
    }
    return previous;
}

void vrd_q028_bus_end(unsigned int previous)
{
    if (vrd_q028_log)
        vrd_q028_agent = previous;
}

void vrd_q028_sh2_fetch_begin(SH2 *sh2, unsigned int address)
{
    if (!vrd_q028_log)
        return;
    if (vrd_q028_fetch_cpu != 0)
        vrd_q028_unknown++;
    vrd_q028_fetch_cpu = sh2->is_slave ? 2 : 1;
    vrd_q028_fetch_address = address;
}

void vrd_q028_sh2_fetch_end(SH2 *sh2, unsigned int address)
{
    unsigned int cpu = sh2->is_slave ? 2 : 1;
    if (!vrd_q028_log)
        return;
    if (vrd_q028_fetch_cpu != cpu || vrd_q028_fetch_address != address)
        vrd_q028_unknown++;
    vrd_q028_fetch_cpu = 0;
    vrd_q028_fetch_address = 0;
}

void vrd_q028_sh2_access(SH2 *sh2, unsigned int address,
    unsigned int value, unsigned int op, unsigned int width)
{
    unsigned int cpu = sh2->is_slave ? 2 : 1;
    const char *kind = "data";
    unsigned int pc = sh2->ppc;
    if (vrd_q028_command_log && !sh2->is_slave && op &&
        (address & 0xdfffffffu) == 0x00004023u) {
        if (fprintf(vrd_q028_command_log,
                "%u,%d,ack,master,0x%08X,0x%08X,%u,0x%08X,%u\n",
                vrd_q028_command_ordinal, vrd_profile_frame, pc, address,
                width, value, (PicoIn.opt & POPT_EN_DRC) != 0) < 0)
            vrd_q028_errors++;
    }
    if (vrd_q028_fetch_cpu == cpu && vrd_q028_fetch_address == address &&
        op == 0 && width == 2) {
        kind = "fetch";
        pc = address;
    }
    if (vrd_q028_agent == VRD_Q028_AGENT_IDL)
        vrd_q028_idl_count(op, address, width);
    vrd_q028_event(cpu, kind, pc, address, width, value,
        op ? "write" : "read");
}

void vrd_q028_sh2_irq(SH2 *sh2, unsigned int entering)
{
    unsigned int cpu = sh2->is_slave ? 1 : 0;
    if (!vrd_q028_log)
        return;
    if (entering)
        vrd_q028_irq_depth[cpu]++;
    else if (vrd_q028_irq_depth[cpu] != 0)
        vrd_q028_irq_depth[cpu]--;
    else
        vrd_q028_unknown++;
    if (fprintf(vrd_q028_log, "# IRQ sequence=%llu frame=%d cpu=%s "
            "action=%s depth=%u pc=0x%08X\n", vrd_q028_sequence,
            vrd_profile_frame, sh2->is_slave ? "slave" : "master",
            entering ? "enter" : "exit", vrd_q028_irq_depth[cpu],
            sh2->ppc) < 0)
        vrd_q028_errors++;
}

void vrd_q028_sh2_instruction(SH2 *sh2, unsigned int pc,
    unsigned int opcode)
{
    if (!vrd_q028_log)
        return;
    if ((opcode & 0xffff) == 0x002b)
        vrd_q028_sh2_irq(sh2, 0);
    if (!sh2->is_slave)
        return;
    if (vrd_q028_cmd02_active && sh2->r[15] < vrd_q028_cmd02_min_sp)
        vrd_q028_cmd02_min_sp = sh2->r[15];
    if (vrd_q028_invocation_active && sh2->r[15] < vrd_q028_invocation_min_sp)
        vrd_q028_invocation_min_sp = sh2->r[15];
    if (pc == 0x06000fa8) {
        if (vrd_q028_cmd02_active)
            vrd_q028_unknown++;
        vrd_q028_cmd02_active = 1;
        vrd_q028_cmd02_entries++;
        vrd_q028_cmd02_entry_sp = sh2->r[15];
        vrd_q028_cmd02_min_sp = sh2->r[15];
    }
    if ((pc == 0x0600bbc0 || pc == 0x060024dc) &&
        !vrd_q028_invocation_active) {
        vrd_q028_invocation_active = 1;
        vrd_q028_invocation_entry_sp = sh2->r[15];
        vrd_q028_invocation_min_sp = sh2->r[15];
    }
    if (pc == 0x0600bbc0)
        vrd_q028_image("wrapper_entry", pc);
    else if (pc == 0x06000ff4 || pc == 0x06000ffe || pc == 0x06001016)
        vrd_q028_image("wrapper_return", pc);
    if (pc == 0x06000fa8 || pc == 0x0600bbc0 || pc == 0x060024dc ||
        pc == 0x0600442c || pc == 0x06000ff4 || pc == 0x06000ffe ||
        pc == 0x06001016) {
        if (fprintf(vrd_q028_log,
                "# CONTEXT frame=%d pc=0x%08X opcode=0x%04X pr=0x%08X "
                "sr=0x%08X r0=0x%08X r1=0x%08X r2=0x%08X r3=0x%08X "
                "r4=0x%08X r5=0x%08X r6=0x%08X r7=0x%08X r13=0x%08X "
                "r14=0x%08X r15=0x%08X irq=%u\n",
                vrd_profile_frame, pc, opcode, sh2->pr, sh2->sr,
                sh2->r[0], sh2->r[1], sh2->r[2], sh2->r[3], sh2->r[4],
                sh2->r[5], sh2->r[6], sh2->r[7], sh2->r[13], sh2->r[14],
                sh2->r[15], vrd_q028_irq_depth[1]) < 0)
            vrd_q028_errors++;
    }
    if (pc == 0x0600442c && vrd_q028_cmd02_active) {
        if (fprintf(vrd_q028_log,
                "# CMD02_STACK ordinal=%u entry=0x%08X min=0x%08X "
                "exit=0x%08X\n", vrd_q028_cmd02_entries,
                vrd_q028_cmd02_entry_sp, vrd_q028_cmd02_min_sp,
                sh2->r[15]) < 0)
            vrd_q028_errors++;
        vrd_q028_cmd02_active = 0;
        vrd_q028_cmd02_completions++;
    }
    if ((pc == 0x06000ff4 || pc == 0x06000ffe || pc == 0x06001016) &&
        vrd_q028_invocation_active) {
        vrd_q028_invocations++;
        if (fprintf(vrd_q028_log,
                "# INVOCATION_STACK ordinal=%u caller=0x%08X entry=0x%08X "
                "min=0x%08X exit=0x%08X sr=0x%08X\n",
                vrd_q028_invocations, pc, vrd_q028_invocation_entry_sp,
                vrd_q028_invocation_min_sp, sh2->r[15], sh2->sr) < 0)
            vrd_q028_errors++;
        vrd_q028_invocation_active = 0;
    }
}

void vrd_q028_idl_begin(unsigned int external_bios)
{
    if (!vrd_q028_log)
        return;
    vrd_q028_bios_null = !external_bios;
    vrd_q028_bus_begin(VRD_Q028_AGENT_IDL);
    if (fprintf(vrd_q028_log, "# IDL_BEGIN bios_null=%u\n",
            vrd_q028_bios_null) < 0)
        vrd_q028_errors++;
}

void vrd_q028_idl_end(void)
{
    if (!vrd_q028_log)
        return;
    vrd_q028_bus_end(VRD_Q028_AGENT_NONE);
    vrd_q028_idl_complete = 1;
    vrd_q028_image("idl_copy_end", 0);
    if (fprintf(vrd_q028_log,
            "# IDL_COPY_END reads=%u writes=%u bios_null=%u\n",
            vrd_q028_idl_reads, vrd_q028_idl_writes,
            vrd_q028_bios_null) < 0 || fflush(vrd_q028_log) != 0)
        vrd_q028_errors++;
}

void vrd_q028_idl_count(unsigned int is_write, unsigned int address,
    unsigned int width)
{
    unsigned int normalized;
    const char *space;
    if (!vrd_q028_log || vrd_q028_agent != VRD_Q028_AGENT_IDL)
        return;
    normalized = vrd_q028_normalize(address, 1, &space);
    if (width == 4 && (vrd_q028_overlaps(normalized, width,
            0x0202bbc0, 0x0202bce8) ||
            vrd_q028_overlaps(normalized, width,
                VRD_Q028_CODE_START, VRD_Q028_CODE_END))) {
        if (is_write) vrd_q028_idl_writes++;
        else vrd_q028_idl_reads++;
    }
}

void vrd_q028_memcpy_source(SH2 *sh2, unsigned int src,
    unsigned int count, unsigned int size)
{
    unsigned int i, value = 0;
    if (!vrd_q028_log)
        return;
    for (i = 0; i < count; i++) {
        const char *space;
        unsigned int normalized = vrd_q028_normalize(src + i * size,
            sh2->is_slave ? 2 : 1, &space);
        if (vrd_q028_watched(normalized, size))
            vrd_q028_unknown++; /* bypass value unavailable => fail closed */
        vrd_q028_event(sh2->is_slave ? 2 : 1, "data", sh2->ppc,
            src + i * size, size, value, "read");
    }
}

static void vrd_q028_early_init(void)
{
    const char *path = getenv("VRD_Q028_ACCESS_LOG");
    const char *family = getenv("VRD_Q028_FAMILY");
    const char *arm = getenv("VRD_Q028_ARM");
    const char *capture_dir = getenv("VRD_Q028_CAPTURE_DIR");
    const char *capture_start = getenv("VRD_Q028_CAPTURE_START");
    const char *capture_end = getenv("VRD_Q028_CAPTURE_END");
    const char *terminal_dir = getenv("VRD_Q028_TERMINAL_DIR");
    const char *command_path = getenv("VRD_Q028_DRC_COMMAND_LOG");
    if (command_path && *command_path) {
        vrd_q028_command_log = fopen(command_path, "wx");
        if (!vrd_q028_command_log || fprintf(vrd_q028_command_log,
                "ordinal,frame,event,agent,pc,address,width,value,engine_drc\n") < 0)
            vrd_q028_errors++;
    }
    if (terminal_dir && *terminal_dir) {
        if (strlen(terminal_dir) >= sizeof(vrd_q028_terminal_dir))
            vrd_q028_errors++;
        else
            strcpy(vrd_q028_terminal_dir, terminal_dir);
    }
    if (capture_dir && *capture_dir && capture_start && capture_end) {
        char manifest_path[640];
        char state_manifest_path[640];
        char fs_manifest_path[640];
        char render_manifest_path[640];
        char callback_manifest_path[640];
        vrd_q028_capture_start = atoi(capture_start);
        vrd_q028_capture_end = atoi(capture_end);
        if (vrd_q028_capture_start < 0 ||
            vrd_q028_capture_end < vrd_q028_capture_start ||
            strlen(capture_dir) >= sizeof(vrd_q028_capture_dir)) {
            vrd_q028_errors++;
        }
        else {
            strcpy(vrd_q028_capture_dir, capture_dir);
            snprintf(manifest_path, sizeof(manifest_path), "%s/post-frame.csv",
                vrd_q028_capture_dir);
            vrd_q028_capture_manifest = fopen(manifest_path, "wx");
            snprintf(state_manifest_path, sizeof(state_manifest_path),
                "%s/state-images.csv", vrd_q028_capture_dir);
            vrd_q028_state_manifest = fopen(state_manifest_path, "wx");
            snprintf(fs_manifest_path, sizeof(fs_manifest_path),
                "%s/fs-preapply.csv", vrd_q028_capture_dir);
            vrd_q028_fs_manifest = fopen(fs_manifest_path, "wx");
            snprintf(render_manifest_path, sizeof(render_manifest_path),
                "%s/render-select.csv", vrd_q028_capture_dir);
            vrd_q028_render_manifest = fopen(render_manifest_path, "wx");
            snprintf(callback_manifest_path, sizeof(callback_manifest_path),
                "%s/callback-bind.csv", vrd_q028_capture_dir);
            vrd_q028_callback_manifest = fopen(callback_manifest_path, "wx");
            if (!vrd_q028_capture_manifest ||
                fprintf(vrd_q028_capture_manifest,
                    "frame,retro_run,event_order,fbctl,post_frame_fs,fen,page_bytes,page0_path,page1_path\n") < 0 ||
                !vrd_q028_state_manifest ||
                fprintf(vrd_q028_state_manifest,
                    "frame,space,bytes,path\n") < 0 ||
                !vrd_q028_fs_manifest ||
                fprintf(vrd_q028_fs_manifest,
                    "preapply_ordinal,frame,retro_run,event_order,site,old_fbctl,old_fs,new_fs,fen,page_bytes,page0_path,page1_path\n") < 0 ||
                !vrd_q028_render_manifest ||
                fprintf(vrd_q028_render_manifest,
                    "render_ordinal,frame,retro_run,event_order,fbctl,render_fs,offs,lines,sync_line,draw_mode,skip_frame,page_bytes,page0_path,page1_path\n") < 0 ||
                !vrd_q028_callback_manifest ||
                fprintf(vrd_q028_callback_manifest,
                    "callback_ordinal,frame,retro_run,event_order,render_ordinal,data_nonnull,width,height,pitch\n") < 0)
                vrd_q028_errors++;
        }
    }
    if (!path || !*path)
        return;
    if (!family || !arm || filestream_exists(path)) {
        vrd_q028_errors++;
        return;
    }
    vrd_q028_family = !strcmp(family, "A") ? 1 :
        (!strcmp(family, "B") ? 2 : (!strcmp(family, "C") ? 3 : 0));
    vrd_q028_arm = !strcmp(arm, "baseline") ? 1 :
        (!strcmp(arm, "control") ? 2 : (!strcmp(arm, "active") ? 3 : 0));
    if (!vrd_q028_family || !vrd_q028_arm) {
        vrd_q028_errors++;
        return;
    }
    vrd_q028_log = fopen(path, "w");
    if (!vrd_q028_log) {
        vrd_q028_errors++;
        return;
    }
    if (fprintf(vrd_q028_log,
            "sequence,frame,order,agent,kind,pc,irq_depth,op,raw,normalized,space,width,value\n"
            "# Q028_OBSERVER version=%u family=%s arm=%s "
            "fetch_complete=true cpu_data_complete=true "
            "dma_dreq_bridge_complete=true filter_after_backend=true\n",
            VRD_Q028_OBSERVER_VERSION, family, arm) < 0)
        vrd_q028_errors++;
}

static int vrd_q028_snapshot_pages(const char *stem, char paths[2][160])
{
    unsigned int page;
    if (!Pico32xMem || !stem) return 0;
    for (page = 0; page < 2; page++) {
        char full[640];
        FILE *stream;
        int ok = 0;
        snprintf(paths[page], 160, "%s-page-%u.bin", stem, page);
        snprintf(full, sizeof(full), "%s/%s", vrd_q028_capture_dir,
            paths[page]);
        stream = fopen(full, "wbx");
        if (stream) {
            ok = fwrite(Pico32xMem->dram[page], 1, 0x20000, stream) ==
                0x20000;
            if (fclose(stream) != 0) ok = 0;
        }
        if (!ok) return 0;
    }
    return 1;
}

void vrd_q028_render_select(unsigned int fbctl, int offs, int lines,
    int sync_line, int draw_mode, int skip_frame)
{
    char stem[96], paths[2][160] = {{0}};
    unsigned int page_bytes = 0;
    unsigned int reread;
    if (!vrd_q028_render_manifest) return;
    vrd_q028_display_order++;
    vrd_q028_render_ordinal++;
    vrd_q028_render_events_in_frame++;
    if (vrd_q028_pending_render != 0 ||
        vrd_q028_pending_render_frame == vrd_profile_frame)
        vrd_q028_errors++;
    vrd_q028_pending_render = vrd_q028_render_ordinal;
    vrd_q028_pending_render_frame = vrd_profile_frame;
    if (vrd_profile_frame >= vrd_q028_capture_start &&
        vrd_profile_frame <= vrd_q028_capture_end) {
        snprintf(stem, sizeof(stem), "render-%04d", vrd_profile_frame);
        if (!vrd_q028_snapshot_pages(stem, paths))
            vrd_q028_errors++;
        else
            page_bytes = 131072;
    }
    reread = Pico32x.vdp_regs[0x0a / 2];
    if (reread != fbctl ||
        fprintf(vrd_q028_render_manifest,
            "%llu,%d,%d,%llu,0x%04X,%u,%d,%d,%d,%d,%d,%u,%s,%s\n",
            vrd_q028_render_ordinal, vrd_profile_frame, vrd_profile_frame,
            vrd_q028_display_order, fbctl & 0xffff,
            (fbctl & P32XV_FS) != 0, offs, lines, sync_line, draw_mode,
            skip_frame, page_bytes, page_bytes ? paths[0] : "-",
            page_bytes ? paths[1] : "-") < 0 ||
        fflush(vrd_q028_render_manifest) != 0)
        vrd_q028_errors++;
}

void vrd_q028_callback_dispatch(const void *data, unsigned int width,
    unsigned int height, unsigned int pitch)
{
    unsigned long long bound = 0;
    if (!vrd_q028_callback_manifest) return;
    vrd_q028_display_order++;
    vrd_q028_callback_ordinal++;
    vrd_q028_callback_events_in_frame++;
    if (vrd_q028_pending_render_frame == vrd_profile_frame)
        bound = vrd_q028_pending_render;
    if (vrd_profile_frame >= vrd_q028_capture_start &&
        vrd_profile_frame <= vrd_q028_capture_end &&
        (bound == 0 || vrd_q028_render_events_in_frame != 1 ||
         vrd_q028_callback_events_in_frame != 1))
        vrd_q028_errors++;
    if (fprintf(vrd_q028_callback_manifest,
            "%llu,%d,%d,%llu,%llu,%u,%u,%u,%u\n",
            vrd_q028_callback_ordinal, vrd_profile_frame, vrd_profile_frame,
            vrd_q028_display_order, bound, data != NULL, width, height,
            pitch) < 0 || fflush(vrd_q028_callback_manifest) != 0)
        vrd_q028_errors++;
    vrd_q028_pending_render = 0;
    vrd_q028_pending_render_frame = -1;
    vrd_q028_render_events_in_frame = 0;
    vrd_q028_callback_events_in_frame = 0;
}

static void vrd_q028_capture_frame(void)
{
    unsigned int fbctl;
    char stem[96], paths[2][160] = {{0}};
    if (!vrd_q028_capture_manifest || !Pico32xMem ||
        vrd_profile_frame < vrd_q028_capture_start ||
        vrd_profile_frame > vrd_q028_capture_end)
        return;
    fbctl = Pico32x.vdp_regs[0x0a / 2];
    vrd_q028_display_order++;
    snprintf(stem, sizeof(stem), "post-frame-%04d", vrd_profile_frame);
    if (!vrd_q028_snapshot_pages(stem, paths) ||
        Pico32x.vdp_regs[0x0a / 2] != fbctl ||
        fprintf(vrd_q028_capture_manifest,
            "%d,%d,%llu,0x%04X,%u,%u,131072,%s,%s\n",
            vrd_profile_frame, vrd_profile_frame, vrd_q028_display_order,
            fbctl & 0xffff, (fbctl & P32XV_FS) != 0,
            (fbctl & P32XV_nFEN) != 0, paths[0], paths[1]) < 0)
        vrd_q028_errors++;
    {
        const void *images[2] = { PicoMem.ram, Pico32xMem->sdram };
        const char *spaces[2] = { "wram", "sdram" };
        const unsigned int sizes[2] = { 0x10000, 0x40000 };
        unsigned int i;
        for (i = 0; i < 2; i++) {
            char path[640];
            FILE *stream;
            int ok = 0;
            snprintf(path, sizeof(path), "%s/frame-%04d-%s.bin",
                vrd_q028_capture_dir, vrd_profile_frame, spaces[i]);
            stream = fopen(path, "wbx");
            if (stream) {
                ok = fwrite(images[i], 1, sizes[i], stream) == sizes[i];
                if (fclose(stream) != 0)
                    ok = 0;
            }
            if (!ok || !vrd_q028_state_manifest ||
                fprintf(vrd_q028_state_manifest, "%d,%s,%u,frame-%04d-%s.bin\n",
                    vrd_profile_frame, spaces[i], sizes[i],
                    vrd_profile_frame, spaces[i]) < 0)
                vrd_q028_errors++;
        }
    }
    if (fflush(vrd_q028_capture_manifest) != 0)
        vrd_q028_errors++;
    if (!vrd_q028_state_manifest || fflush(vrd_q028_state_manifest) != 0)
        vrd_q028_errors++;
}

void vrd_q028_fs_preapply(const char *site, unsigned int old_fbctl,
    unsigned int new_fs)
{
    unsigned int old_fs = (old_fbctl & P32XV_FS) != 0;
    unsigned int fen = (old_fbctl & P32XV_nFEN) != 0;
    char stem[96], paths[2][160] = {{0}};
    if (vrd_q028_capture_start < 0)
        return;
    if (vrd_profile_frame < vrd_q028_capture_start ||
        vrd_profile_frame > vrd_q028_capture_end)
        return;
    if (!vrd_q028_fs_manifest || !Pico32xMem || !site || old_fs == new_fs) {
        vrd_q028_fs_errors++;
        vrd_q028_errors++;
        return;
    }
    vrd_q028_fs_snapshots++;
    vrd_q028_display_order++;
    snprintf(stem, sizeof(stem), "preapply-%04u-frame-%04d-%s",
        vrd_q028_fs_snapshots, vrd_profile_frame, site);
    if (!vrd_q028_snapshot_pages(stem, paths) ||
        fprintf(vrd_q028_fs_manifest,
            "%u,%d,%d,%llu,%s,0x%04X,%u,%u,%u,131072,%s,%s\n",
            vrd_q028_fs_snapshots, vrd_profile_frame, vrd_profile_frame,
            vrd_q028_display_order, site, old_fbctl & 0xffff, old_fs,
            new_fs, fen, paths[0], paths[1]) < 0) {
        vrd_q028_fs_errors++;
        vrd_q028_errors++;
    }
    if (fflush(vrd_q028_fs_manifest) != 0) {
        vrd_q028_fs_errors++;
        vrd_q028_errors++;
    }
}

static void vrd_q028_finish(const char *reason)
{
    if (vrd_q028_capture_start >= 0) {
        char path[640];
        FILE *stream;
        snprintf(path, sizeof(path), "%s/capture-session.csv",
            vrd_q028_capture_dir);
        stream = fopen(path, "wx");
        if (!stream || fprintf(stream,
                "observer_version,start,end,fs_snapshots,fs_errors,sh2_interpreter\n"
                "%u,%d,%d,%u,%u,%u\n", VRD_Q028_OBSERVER_VERSION,
                vrd_q028_capture_start, vrd_q028_capture_end,
                vrd_q028_fs_snapshots, vrd_q028_fs_errors,
                (PicoIn.opt & POPT_EN_DRC) == 0) < 0 || fclose(stream) != 0)
            vrd_q028_errors++;
    }
    if (vrd_q028_terminal_dir[0]) {
        const void *images[2] = { PicoMem.ram, Pico32xMem->sdram };
        const char *spaces[2] = { "wram", "sdram" };
        const unsigned int sizes[2] = { 0x10000, 0x40000 };
        unsigned int i;
        for (i = 0; i < 2; i++) {
            char path[640];
            FILE *stream;
            int ok = 0;
            snprintf(path, sizeof(path), "%s/terminal-%s.bin",
                vrd_q028_terminal_dir, spaces[i]);
            stream = fopen(path, "wbx");
            if (stream) {
                ok = fwrite(images[i], 1, sizes[i], stream) == sizes[i];
                if (fclose(stream) != 0)
                    ok = 0;
            }
            if (!ok)
                vrd_q028_errors++;
        }
    }
    if (vrd_q028_capture_manifest) {
        if (fclose(vrd_q028_capture_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_capture_manifest = NULL;
    }
    if (vrd_q028_state_manifest) {
        if (fclose(vrd_q028_state_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_state_manifest = NULL;
    }
    if (vrd_q028_fs_manifest) {
        if (fclose(vrd_q028_fs_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_fs_manifest = NULL;
    }
    if (vrd_q028_render_manifest) {
        if (fclose(vrd_q028_render_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_render_manifest = NULL;
    }
    if (vrd_q028_callback_manifest) {
        if (fclose(vrd_q028_callback_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_callback_manifest = NULL;
    }
    if (vrd_q028_command_log) {
        if (vrd_q028_cmd_byte_pending || vrd_q028_command_ordinal != 67 ||
            fprintf(vrd_q028_command_log,
                "# COMPLETE,frames=%d,commands=%u,drc_enabled=%u,errors=%llu\n",
                vrd_profile_frame, vrd_q028_command_ordinal,
                (PicoIn.opt & POPT_EN_DRC) != 0, vrd_q028_errors) < 0 ||
            fclose(vrd_q028_command_log) != 0)
            vrd_q028_errors++;
        vrd_q028_command_log = NULL;
    }
    if (!vrd_q028_log)
        return;
    vrd_q028_image("terminal", 0);
    vrd_q028_m68k_uninstall();
    if (vrd_q028_capture_start >= 0 &&
        (vrd_q028_fs_errors != 0 || vrd_q028_fs_snapshots == 0 ||
         vrd_q028_pending_render != 0))
        vrd_q028_errors++;
    if (fprintf(vrd_q028_log,
            "# COMPLETE reason=%s events=%llu errors=%llu unknown=%llu "
            "dropped=%llu idl_complete=%u bios_null=%u idl_reads=%u "
            "idl_writes=%u fetch_complete=true cpu_data_complete=true "
            "dma_dreq_bridge_complete=true sh2_interpreter=%u "
            "cmd02_entries=%u cmd02_completions=%u cmd02_open=%u\n",
            reason, vrd_q028_events, vrd_q028_errors, vrd_q028_unknown,
            vrd_q028_dropped, vrd_q028_idl_complete, vrd_q028_bios_null,
            vrd_q028_idl_reads, vrd_q028_idl_writes,
            (PicoIn.opt & POPT_EN_DRC) == 0, vrd_q028_cmd02_entries,
            vrd_q028_cmd02_completions, vrd_q028_cmd02_active) < 0 ||
        fflush(vrd_q028_log) != 0)
        vrd_q028_errors++;
    fclose(vrd_q028_log);
    vrd_q028_log = NULL;
}
