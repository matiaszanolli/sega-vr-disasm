static unsigned int vrd_q028_invocation_active;
static unsigned int vrd_q028_invocation_entry_sp;
static unsigned int vrd_q028_invocation_min_sp;
static unsigned int vrd_q028_invocations;
static unsigned int vrd_q028_m68k_installed;
static char vrd_q028_capture_dir[512];
static char vrd_q028_terminal_dir[512];
static int vrd_q028_capture_start = -1;
