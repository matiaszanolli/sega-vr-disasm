static const char *vrd_q028_agent_name(unsigned int agent)
{
    static const char *const names[] = {
        "none", "idl", "master_dmac0", "master_dmac1",
        "slave_dmac0", "slave_dmac1", "master_dreq0",
        "slave_dreq0", "master_dreq1", "slave_dreq1", "bridge"
    };
    return agent < sizeof(names) / sizeof(names[0]) ? names[agent] : "unknown";
}

static unsigned int vrd_q028_normalize(unsigned int raw, unsigned int cpu,
    const char **space)
{
    unsigned int a = raw;
    if (cpu == 0 && (a & 0x00ffffffu) >= 0x00ff6000u &&
        (a & 0x00ffffffu) < 0x00ff6a00u) {
        *space = "wram";
        return a & 0x00ffffffu;
    }
    if (cpu == 0 && a >= 0x008abbc0 && a < 0x008abce8) {
        *space = "rom";
        return 0x02000000u + (a - 0x00880000u);
    }
    if (cpu != 0 && (a & 0xdfffffffu) >= 0x0202bbc0u &&
        (a & 0xdfffffffu) < 0x0202bce8u) {
        *space = "rom";
        return a & 0xdfffffffu;
    }
    if (cpu != 0 && (a & 0xdfffffffu) >= VRD_Q028_CODE_START &&
        (a & 0xdfffffffu) < VRD_Q028_STACK_END) {
        *space = "sdram";
        return a & 0xdfffffffu;
    }
    *space = "other";
    return a;
}

static void vrd_q028_sram_access(unsigned int cpu, unsigned int pc,
    unsigned int raw, unsigned int width, unsigned int value, unsigned int write)
{
    struct vrd_q028_sram_state *state;
    const struct vrd_q028_sram_image *image;
    unsigned int i, expected;
    if (cpu == 0 || cpu > 2) return;
    state = &vrd_q028_sram_state[cpu];
    if (!state->installing) {
        for (i=0;i<3;i++) if (pc==vrd_q028_sram_images[i].dt_pc) {
            vrd_q028_errors++; return;
        }
    }
    if (!state->installing && !write && width == 4) {
        for (i = 0; i < 3; i++) {
            image = &vrd_q028_sram_images[i];
            if (pc == image->read_pc && raw == image->source) {
                state->active = 0; state->installing = i + 1;
                state->offset = 0; state->pending = 0; break;
            }
        }
    }
    if (state->installing) {
        image = &vrd_q028_sram_images[state->installing - 1];
        if (state->pending==2) {
            if (write || width!=2 || pc!=image->dt_pc || raw!=(image->dt_pc&image->dt_mask) || value!=image->dt_opcode) {
                state->installing=state->active=0; vrd_q028_errors++; return;
            }
            if (state->offset==image->size) { state->active=image->view; state->installing=0; }
            else state->pending=0;
            return;
        }
        expected = ((unsigned int)image->bytes[state->offset] << 24) |
            ((unsigned int)image->bytes[state->offset+1] << 16) |
            ((unsigned int)image->bytes[state->offset+2] << 8) | image->bytes[state->offset+3];
        if (width != 4 || value != expected || write != state->pending ||
            pc != (write ? image->write_pc : image->read_pc) ||
            raw != (write ? 0xc0000000u : image->source) + state->offset) {
            state->installing = state->active = 0; vrd_q028_errors++; return;
        }
        if (!write) state->pending = 1;
        else {
            state->pending = 2; state->offset += 4;
        }
    }
    else if (write && state->active) {
        image = &vrd_q028_sram_images[state->active - 2];
        if (raw < 0xc0000000u + image->size && (unsigned long long)raw + width > 0xc0000000u)
            state->active = 0;
    }
}

static void vrd_q028_wram_access(unsigned int pc, unsigned int raw,
    unsigned int width, unsigned int value, unsigned int write)
{
    struct vrd_q028_sram_state *state=&vrd_q028_wram_state;
    const struct vrd_q028_wram_image *image;
    unsigned int i, expected=0, copy_pc;
    raw &= 0xffffffu;
    if (!state->installing && !write) {
        for (i=0;i<3;i++) {
            image=&vrd_q028_wram_images[i];
            if (raw==image->source && pc==(image->view==5 ? 0x4a8u : 0x880fdeu)) {
                state->installing=image->view; state->active=state->offset=state->pending=0; break;
            }
        }
    }
    if (state->installing) {
        image=&vrd_q028_wram_images[state->installing-5];
        copy_pc=image->view==5 ? 0x4a8u+(state->offset/4)*2 : 0x880fdeu;
        for (i=0;i<image->width;i++) expected=(expected<<8)|image->bytes[state->offset+i];
        if (width!=image->width || write!=state->pending || pc!=copy_pc || value!=expected ||
            raw!=(write ? 0xff0000u : image->source)+state->offset) {
            state->active=state->installing=0; vrd_q028_errors++; return;
        }
        if (!write) state->pending=1;
        else {
            for (i=0;i<width;i++) vrd_q028_wram_bytes[state->offset+i]=(value>>((width-1-i)*8))&255;
            state->offset+=width; state->pending=0;
            if (state->offset==image->size) { state->active=image->view; state->installing=0; }
        }
    }
    else if (write && state->active) {
        image=&vrd_q028_wram_images[state->active-5];
        for (i=0;i<width;i++) if (raw+i>=0xff0000u && raw+i<0xff0000u+image->size) {
            unsigned int offset=raw+i-0xff0000u;
            if (image->mask[offset]) { state->active=0; return; }
            vrd_q028_wram_bytes[offset]=(value>>((width-1-i)*8))&255;
        }
    }
}

static unsigned int vrd_q028_base_view(unsigned int cpu, unsigned int pc)
{
    if (!cpu && pc>=0xff0000u && pc<0xff0020u)
        return vrd_q028_wram_state.active;
    if (cpu && pc >= 0xc0000000u && pc < 0xc0001000u)
        return vrd_q028_sram_state[cpu].active;
    if (vrd_q028_bios_verified && pc < (cpu == 0 ? 256u : (cpu == 1 ? 2048u : 1024u)))
        return 1;
    return 0;
}

static struct vrd_q028_host_patch *vrd_q028_host_at(unsigned int pc)
{
    unsigned int i;
    for (i=0;i<vrd_q028_host_patches_count;i++)
        if (vrd_q028_host_patches[i].live && vrd_q028_host_patches[i].pc==pc)
            return &vrd_q028_host_patches[i];
    return NULL;
}

static unsigned int vrd_q028_image_view(unsigned int cpu, unsigned int pc)
{
    unsigned int view=vrd_q028_base_view(cpu,pc);
    struct vrd_q028_host_patch *patch=cpu ? NULL : vrd_q028_host_at(pc);
    if (patch) {
        if (patch->view!=view) { vrd_q028_errors++; return view; }
        return view+16;
    }
    return view;
}

static unsigned int vrd_q028_idle_pair(unsigned int real, unsigned int fake)
{
    unsigned int base;
    switch (real) {
    case 0x66fa: case 0x66f8: case 0x66f6: case 0x66f2:
    case 0x67fa: case 0x67f8: case 0x67f6: case 0x67f2:
    case 0x60fe: case 0x60fc: break;
    default: return 0;
    }
    base=(real&0xfe)|0x7100;
    if (real&0x100) base|=0x400;
    if (!(real&0xf00)) base|=0xc00;
    return fake==base || fake==(base|0x200);
}

static void vrd_q028_host_row(unsigned int pc,unsigned int old,unsigned int replacement,const char *operation,const char *source)
{
    if (!vrd_q028_host_log || fprintf(vrd_q028_host_log,
        "%llu,%llu,%d,0,0x%08X,0x%04X,0x%04X,%s,%s\n",vrd_q028_host_count,
        vrd_q028_sequence,vrd_profile_frame,pc,old,replacement,operation,source)<0) vrd_q028_errors++;
    vrd_q028_host_count++; vrd_q028_host_last_boundary=vrd_q028_sequence;
}

void vrd_q028_idle_install(unsigned short *pointer,unsigned int pc,unsigned int old,unsigned int replacement,void *ctx)
{
    struct vrd_q028_host_patch *patch=NULL,*grown;
    unsigned int i,view;
    if (!vrd_q028_active) return;
    pc &= 0xffffffu; view=vrd_q028_base_view(0,pc);
    if (ctx!=&PicoCpuFM68k || !vrd_q028_sequence || vrd_q028_last_record.sequence+1!=vrd_q028_sequence ||
        vrd_q028_last_record.cpu!=0 || vrd_q028_last_record.agent || !(vrd_q028_last_record.kind_flags&1) ||
        vrd_q028_last_record.pc!=pc || vrd_q028_last_record.frame!=(unsigned int)vrd_profile_frame ||
        vrd_q028_last_record.value!=old || !vrd_q028_idle_pair(old,replacement) || *pointer!=replacement ||
        !vrd_q028_site_base(0,view,pc,old) || !vrd_q028_site_base(0,view+16,pc,replacement) || vrd_q028_host_at(pc)) {
        vrd_q028_errors++; return;
    }
    for (i=0;i<vrd_q028_host_patches_count;i++) if (vrd_q028_host_patches[i].pointer==pointer) { patch=&vrd_q028_host_patches[i]; break; }
    if (!patch) {
        grown=realloc(vrd_q028_host_patches,(vrd_q028_host_patches_count+1)*sizeof(*grown));
        if (!grown) { vrd_q028_errors++; return; }
        vrd_q028_host_patches=grown; patch=&grown[vrd_q028_host_patches_count++];
    }
    patch->pointer=pointer; patch->pc=pc; patch->view=view; patch->real=old; patch->fake=replacement; patch->live=1;
    if (view>=5 && view<=7) {
        unsigned int offset=pc-0xff0000u;
        if ((((unsigned int)vrd_q028_wram_bytes[offset]<<8)|vrd_q028_wram_bytes[offset+1])!=old) vrd_q028_errors++;
        vrd_q028_wram_bytes[offset]=replacement>>8; vrd_q028_wram_bytes[offset+1]=replacement&255;
    }
    vrd_q028_host_row(pc,old,replacement,"install","fame-idle-detector-after-write");
}

void vrd_q028_idle_restore(unsigned short *pointer,unsigned int old,unsigned int replacement)
{
    unsigned int i;
    struct vrd_q028_host_patch *patch=NULL;
    if (!vrd_q028_active) return;
    for (i=0;i<vrd_q028_host_patches_count;i++) if (vrd_q028_host_patches[i].pointer==pointer) { patch=&vrd_q028_host_patches[i]; break; }
    if (!patch || !patch->live || patch->fake!=old || patch->real!=replacement ||
        patch->view!=vrd_q028_base_view(0,patch->pc) || !vrd_q028_idle_pair(replacement,old) || *pointer!=replacement) {
        vrd_q028_errors++; return;
    }
    if (patch->view>=5 && patch->view<=7) {
        unsigned int offset=patch->pc-0xff0000u;
        if ((((unsigned int)vrd_q028_wram_bytes[offset]<<8)|vrd_q028_wram_bytes[offset+1])!=old) vrd_q028_errors++;
        vrd_q028_wram_bytes[offset]=replacement>>8; vrd_q028_wram_bytes[offset+1]=replacement&255;
    }
    patch->live=0;
    vrd_q028_host_row(patch->pc,old,replacement,"restore","sek-finish-idle-after-expression");
}

static void vrd_q028_host_data(unsigned int raw,unsigned int width,unsigned int write)
{
    unsigned int i;
    raw &= 0xffffffu;
    for (i=0;i<vrd_q028_host_patches_count;i++) {
        struct vrd_q028_host_patch *patch=&vrd_q028_host_patches[i];
        if ((write && raw<patch->pc+2 && (unsigned long long)raw+width>patch->pc) ||
            (!vrd_q028_wram_state.active && patch->pc>=0xff0000u && patch->pc<0xff0020u)) patch->live=0;
    }
}

/* Resource-only derived facts. Each CSV row refers to one original raw write;
 * polling reads remain solely in the binary stream. No command lifecycle is
 * inferred from low-byte clears or COMM1 signal bits. */
static void vrd_q028_comm_fact(const struct vrd_q028_record *record)
{
    unsigned int address = record->raw, pc = record->pc, i, lane, byte, tags = 0, mask = 0;
    int offset;
    unsigned int write = (record->kind_flags & 4) != 0;
    if (record->cpu > 2 || !(record->kind_flags & 2)) return;
    if (record->cpu == 0) {
        address &= 0xffffffu;
        if ((unsigned long long)address + record->width <= 0xa15120u || address >= 0xa15128u) return;
        offset = (int)address - 0xa15120;
        if (pc >= 0x880000u && pc < 0xc80000u) pc -= 0x880000u;
    }
    else {
        address &= 0xdfffffffu;
        if ((unsigned long long)address + record->width <= 0x4020 || address >= 0x4028) return;
        offset = (int)address - 0x4020;
    }
    if (!write) {
        if (!vrd_q028_comm_game && record->cpu == 0 && record->width == 4) {
            if ((pc == 0x808 || pc == 0x8d0) && offset == 0 && record->value == 0x4d5f4f4b) {
                unsigned int route = pc == 0x808 ? 1 : 2;
                if (vrd_q028_comm_boot_route && vrd_q028_comm_boot_route != route) vrd_q028_errors++;
                vrd_q028_comm_boot_route = route;
                vrd_q028_comm_boot_reads |= 1;
            }
            if ((pc == 0x810 || pc == 0x8d8) && offset == 4 && record->value == 0x535f4f4b) {
                if (vrd_q028_comm_boot_route != (pc == 0x810 ? 1u : 2u)) vrd_q028_errors++;
                vrd_q028_comm_boot_reads |= 2;
            }
        }
        return;
    }
    for (i = 0; i < record->width; i++) {
        if (offset+(int)i < 0 || offset+(int)i >= 8) continue;
        lane = offset+i; byte = (record->value >> ((record->width-1-i)*8)) & 255;
        mask |= 1u << lane; vrd_q028_comm_lanes[lane] = byte;
        vrd_q028_comm_last[lane] = record->sequence;
        if (vrd_q028_comm_game) {
            if (lane == 0 && record->cpu == 1 && byte == 0) tags |= 1;
            if (lane == 1) tags |= 2;
            if (lane == 3) tags |= 4;
            if (lane == 0 && record->cpu == 1 && byte == 1) tags |= 8;
            if (lane == 0 && record->cpu == 0 && byte == 1) tags |= 16;
        }
    }
    for (i = 0; i < 5; i++) if (tags & (1u << i)) vrd_q028_comm_counts[i]++;
    vrd_q028_comm_writes++;
    if (vrd_q028_command_log && fprintf(vrd_q028_command_log,
        "%llu,%u,%u,0x%08X,0x%08X,%u,0x%08X,%u,%u,%u\n", record->sequence,
        record->frame, record->cpu, record->pc, record->raw, record->width, record->value,
        vrd_q028_comm_game, tags, mask) < 0) vrd_q028_errors++;
    if (!vrd_q028_comm_game && record->cpu == 0 && (pc == 0x81a || pc == 0x8e2) &&
        offset == 0 && record->width == 4 && record->value == 0) {
        if (vrd_q028_comm_boot_reads != 3 || vrd_q028_comm_boot_route != (pc == 0x81a ? 1u : 2u)) vrd_q028_errors++;
        else vrd_q028_comm_game = 1;
    }
}

void vrd_q028_bios_snapshot(unsigned int bios_null, unsigned int cartridge)
{
    const unsigned short *actual[3];
    const unsigned char *expected[3] = { vrd_q028_bios_m68k, vrd_q028_bios_master, vrd_q028_bios_slave };
    const unsigned int sizes[3] = { 256, 2048, 1024 };
    const char *names[3] = { "m68k", "master", "slave" };
    unsigned int cpu, i, byte;
    char path[640];
    FILE *stream;
    if (!vrd_q028_active) return;
    if (vrd_q028_bios_verified || !Pico32xMem || !bios_null || !cartridge) {
        vrd_q028_errors++; return;
    }
    actual[0] = (const unsigned short *)Pico32xMem->m68k_rom;
    actual[1] = Pico32xMem->sh2_rom_m.w;
    actual[2] = Pico32xMem->sh2_rom_s.w;
    snprintf(path, sizeof(path), "%s/bootstrap-images-v10.json", vrd_q028_access_dir);
    stream = fopen(path, "wx");
    if (!stream) { vrd_q028_errors++; return; }
    fprintf(stream, "{\"bios_null\":true,\"cartridge\":true,\"images\":{");
    vrd_q028_bios_verified = 1;
    for (cpu = 0; cpu < 3; cpu++) {
        fprintf(stream, "%s\"%s\":\"", cpu ? "," : "", names[cpu]);
        for (i = 0; i < sizes[cpu]; i++) {
            byte = (actual[cpu][i/2] >> (i%2 ? 0 : 8)) & 255;
            if (byte != expected[cpu][i]) vrd_q028_bios_verified = 0;
            fprintf(stream, "%02x", byte);
        }
        fputc('"', stream);
    }
    fprintf(stream, "},\"schema\":\"vrd-vr60-q028-bootstrap-images-v10\"}\n");
    if (ferror(stream)) vrd_q028_errors++;
    if (fclose(stream) != 0) vrd_q028_errors++;
    if (!vrd_q028_bios_verified) vrd_q028_errors++;
}

static int vrd_q028_overlaps(unsigned int a, unsigned int width,
    unsigned int lo, unsigned int hi)
{
    unsigned long long end = (unsigned long long)a + width;
    return width != 0 && a < hi && end > lo;
}

static int vrd_q028_descriptor_overlap(unsigned int a, unsigned int width)
{
    unsigned int i, g, base, count;
    if (vrd_q028_family == 1) {
        base = 0x0600c128; count = 4;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14, base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 2) {
        base = 0x0600c178; count = 8;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14, base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 3) {
        for (g = 0; g < 7; g++)
            for (i = 0; i < 3; i++) {
                base = 0x0600c254 + g * 0x78 + i * 0x14;
                if (vrd_q028_overlaps(a, width, base, base + 2))
                    return 1;
            }
    }
    return 0;
}

static int vrd_q028_source_overlap(unsigned int a, unsigned int width)
{
    unsigned int i, g, base, count;
    if (vrd_q028_family == 1) {
        base = 0x00ff6128; count = 4;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14,
                    base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 2) {
        base = 0x00ff6178; count = 8;
        for (i = 0; i < count; i++)
            if (vrd_q028_overlaps(a, width, base + i * 0x14,
                    base + i * 0x14 + 2))
                return 1;
    }
    else if (vrd_q028_family == 3) {
        for (g = 0; g < 7; g++)
            for (i = 0; i < 3; i++) {
                base = 0x00ff6254 + g * 0x78 + i * 0x14;
                if (vrd_q028_overlaps(a, width, base, base + 2))
                    return 1;
            }
    }
    return 0;
}

static int vrd_q028_close_chunk(void)
{
    struct vrd_q028_chunk_header header;
    if (!vrd_q028_log)
        return 1;
    if (fflush(vrd_q028_log) != 0 || fseek(vrd_q028_log, 0, SEEK_SET) != 0) {
        vrd_q028_errors++;
        return 0;
    }
    memset(&header, 0, sizeof(header));
    memcpy(header.magic, "VRDQA8\0\0", 8);
    header.version = 8; header.record_size = sizeof(struct vrd_q028_record);
    header.ordinal = vrd_q028_chunk_ordinal;
    header.record_count = vrd_q028_chunk_records;
    header.first_sequence = vrd_q028_chunk_first_sequence;
    memcpy(header.image_hash_prefix, VRD_Q028_IMAGE_HASH_PREFIX, 8);
    memcpy(header.tool_hash_prefix, VRD_Q028_TOOL_HASH_PREFIX, 8);
    memcpy(header.site_hash_prefix, VRD_Q028_SITE_HASH_PREFIX, 8);
    if (fwrite(&header, 1, sizeof(header), vrd_q028_log) != sizeof(header) ||
        fclose(vrd_q028_log) != 0) {
        vrd_q028_errors++;
        vrd_q028_log = NULL;
        return 0;
    }
    vrd_q028_log = NULL;
    return 1;
}

static int vrd_q028_open_chunk(void)
{
    char path[640];
    struct vrd_q028_chunk_header header;
    if (vrd_q028_chunk_ordinal >= VRD_Q028_CHUNK_CAP) {
        vrd_q028_resource_limit = 1;
        return 0;
    }
    vrd_q028_chunk_ordinal++;
    snprintf(path, sizeof(path), "%s/access-events-v8-%04u.bin",
        vrd_q028_access_dir, vrd_q028_chunk_ordinal);
    vrd_q028_log = fopen(path, "w+xb");
    if (!vrd_q028_log) {
        vrd_q028_errors++;
        return 0;
    }
    memset(&header, 0, sizeof(header));
    memcpy(header.magic, "VRDQA8\0\0", 8);
    header.version = 8; header.record_size = sizeof(struct vrd_q028_record);
    header.ordinal = vrd_q028_chunk_ordinal;
    header.first_sequence = vrd_q028_sequence;
    memcpy(header.image_hash_prefix, VRD_Q028_IMAGE_HASH_PREFIX, 8);
    memcpy(header.tool_hash_prefix, VRD_Q028_TOOL_HASH_PREFIX, 8);
    memcpy(header.site_hash_prefix, VRD_Q028_SITE_HASH_PREFIX, 8);
    if (fwrite(&header, 1, sizeof(header), vrd_q028_log) != sizeof(header)) {
        vrd_q028_errors++;
        return 0;
    }
    vrd_q028_chunk_records = 0;
    vrd_q028_chunk_first_sequence = vrd_q028_sequence;
    return 1;
}

static void vrd_q028_event(unsigned int cpu, const char *kind,
    unsigned int pc, unsigned int raw, unsigned int width,
    unsigned int value, const char *op)
{
    const char *space;
    unsigned int normalized, irq_depth = 0, kind_flags, site = 0;
    unsigned short slot = 0xffff;
    struct vrd_q028_record record;
    struct vrd_q028_cpu_context *context = NULL;

    if (!vrd_q028_log)
        return;
    if ((!strcmp(kind, "fetch") && (width == 0 || width > 10)) ||
        (strcmp(kind, "fetch") && width != 1 && width != 2 && width != 4)) {
        vrd_q028_unknown++;
        return;
    }
    normalized = vrd_q028_normalize(raw, cpu, &space);
    if (cpu == 1 || cpu == 2)
        irq_depth = vrd_q028_irq_depth[cpu - 1];
    if (width == 1) value &= 0xff;
    else if (width == 2) value &= 0xffff;
    if (vrd_profile_frame != vrd_q028_order_frame) {
        vrd_q028_order_frame = vrd_profile_frame;
        vrd_q028_within_frame_order = 0;
    }
    memset(&record, 0, sizeof(record));
    record.access_slot = 0xffff;
    record.sequence = vrd_q028_sequence; record.frame = vrd_profile_frame;
    record.within_frame_order = vrd_q028_within_frame_order++;
    record.pc = pc; record.raw = raw; record.normalized = normalized;
    record.value = value; record.width = width; record.irq_depth = irq_depth;
    if (vrd_q028_agent != VRD_Q028_AGENT_NONE) {
        record.cpu = 255; record.agent = vrd_q028_agent;
        record.static_site_index = 0; record.access_slot = 0xffff;
        vrd_q028_agent_records[vrd_q028_agent]++;
    }
    else if (cpu <= 2) {
        context = &vrd_q028_cpu_context[cpu];
        record.cpu = cpu; record.agent = 0;
        if (!strcmp(kind, "fetch")) {
            if (cpu && vrd_q028_reset_phase[cpu] < 3) {
                if (vrd_q028_reset_phase[cpu] != 2 || pc != 0x204 || !vrd_q028_bios_verified)
                    vrd_q028_errors++;
                vrd_q028_reset_phase[cpu] = 3;
            }
            context->pc = pc; context->opcode_word = value & 0xffff;
            context->view = vrd_q028_image_view(cpu, pc);
            if (!cpu && pc>=0xff0000u && pc<0xff0020u && context->view) {
                const struct vrd_q028_wram_image *image=&vrd_q028_wram_images[(context->view&15)-5];
                unsigned int i, offset=pc-0xff0000u;
                if (offset>=image->code_size) vrd_q028_errors++;
                /* Host RAM is word-swapped; this is not an emulated read. */
                for (i=0;i<image->size;i++)
                    if (PicoMem.ram[i^1] != vrd_q028_wram_bytes[i]) { vrd_q028_errors++; break; }
            }
            context->opcode_hash = vrd_q028_site_opcode_hash(cpu, context->view, pc,
                context->opcode_word);
            context->next_slot = 0; context->live = 1;
            record.opcode_hash = context->opcode_hash;
            site = vrd_q028_site_lookup(cpu, context->view, pc, context->opcode_word,
                1, 0, width);
            vrd_q028_cpu_counts[cpu][0]++;
        }
        else {
            if (cpu && vrd_q028_reset_phase[cpu] < 2 && pc == 0) {
                unsigned int phase = vrd_q028_reset_phase[cpu];
                unsigned int expected = phase ? (cpu == 1 ? 0x06040000u : 0x0603f800u) : 0x204u;
                if (strcmp(op, "read") || width != 4 || raw != phase * 4 || value != expected || !vrd_q028_bios_verified)
                    vrd_q028_errors++;
                slot = phase; vrd_q028_reset_phase[cpu]++;
                context->opcode_word = context->opcode_hash = context->view = 0;
            }
            else if (!context->live || context->pc != pc || context->next_slot == 0xffff) {
                vrd_q028_unattributed++;
            }
            else slot = context->next_slot++;
            record.access_slot = slot;
            record.opcode_hash = context->opcode_hash;
            site = vrd_q028_site_lookup(cpu, context->view, pc, context->opcode_word,
                0, !strcmp(op, "write"), width);
            vrd_q028_sram_access(cpu, pc, raw, width, value, !strcmp(op, "write"));
            if (!cpu) vrd_q028_wram_access(pc, raw, width, value, !strcmp(op, "write"));
            if (!cpu) vrd_q028_host_data(raw,width,!strcmp(op,"write"));
            vrd_q028_cpu_counts[cpu][!strcmp(op, "write") ? 2 : 1]++;
        }
        record.static_site_index = site;
        if (!site) vrd_q028_unattributed++;
    }
    else {
        vrd_q028_unknown++;
    }
    kind_flags = !strcmp(kind, "fetch") ? 1u : 2u;
    kind_flags |= !strcmp(op, "write") ? 4u : 8u;
    if (record.static_site_index || record.cpu == 255) kind_flags |= 16u;
    record.kind_flags = kind_flags;
    vrd_q028_comm_fact(&record);
    if (vrd_q028_events >= VRD_Q028_EVENT_CAP) {
        vrd_q028_resource_limit = 1;
        return;
    }
    if (fwrite(&record, 1, sizeof(record), vrd_q028_log) != sizeof(record))
        vrd_q028_errors++;
    else
        vrd_q028_chunk_records++;
    vrd_q028_sequence++;
    vrd_q028_events++;
    vrd_q028_last_record=record;
    if (vrd_q028_chunk_records == VRD_Q028_RECORDS_PER_CHUNK) {
        if (!vrd_q028_close_chunk())
            vrd_q028_errors++;
        else if (!vrd_q028_open_chunk() && !vrd_q028_resource_limit)
            vrd_q028_errors++;
    }
}

static void vrd_q028_image(const char *label, unsigned int pc)
{
    unsigned int i;
    const unsigned char *bytes;
    if (!vrd_q028_metadata_log || !Pico32xMem)
        return;
    bytes = Pico32xMem->sdram + 0xbbc0;
    if (fprintf(vrd_q028_metadata_log,
            "# IMAGE sequence=%llu frame=%d label=%s pc=0x%08X bytes=",
            vrd_q028_sequence, vrd_profile_frame, label, pc) < 0) {
        vrd_q028_errors++;
        return;
    }
    for (i = 0; i < 296; i++)
        if (fprintf(vrd_q028_metadata_log, "%02X", bytes[i]) < 0) {
            vrd_q028_errors++;
            break;
        }
    if (fputc('\n', vrd_q028_metadata_log) == EOF)
        vrd_q028_errors++;
}

void vrd_q028_idl_count(unsigned int is_write, unsigned int address,
    unsigned int width);

void vrd_q028_m68k_fetch(unsigned int address, unsigned int width,
    unsigned int value)
{
    vrd_q028_event(0, "fetch", address, address, width, value, "read");
}

void vrd_q028_m68k_instruction(unsigned int pc)
{
    /* FAME exposes every opcode PC before its direct mapped fetch.  The opcode
     * word is exact; the ten-byte conservative span is the architectural
     * maximum instruction length and makes an extension overlap fail closed. */
    unsigned int opcode_word = vrd_q028_orig_read_word ?
        vrd_q028_orig_read_word(pc) & 0xffff : 0;
    unsigned int width = vrd_q028_site_fetch_width(0, vrd_q028_image_view(0, pc), pc, opcode_word);
    if (!width) width = 2; /* retained below as site-zero/unattributed */
    vrd_q028_event(0, "fetch", pc, pc, width,
        opcode_word, "read");
    if (vrd_q028_metadata_log && pc < 0x008abce8 &&
        (unsigned long long)pc + 10 > 0x008abbc0) {
        if (fprintf(vrd_q028_metadata_log,
                "# M68K_FETCH_SPAN pc=0x%08X width=10 outcome=forbidden\n",
                pc) < 0)
            vrd_q028_errors++;
        vrd_q028_unknown++;
    }
}

static unsigned int vrd_q028_read_byte(unsigned int address)
{
    unsigned int value = vrd_q028_orig_read_byte(address);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 1, value, "read");
    return value;
}

static unsigned int vrd_q028_read_word(unsigned int address)
{
    unsigned int value = vrd_q028_orig_read_word(address);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 2, value, "read");
    return value;
}

static unsigned int vrd_q028_read_long(unsigned int address)
{
    unsigned int value = vrd_q028_orig_read_long(address);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 4, value, "read");
    return value;
}

static void vrd_q028_m68k_source_context(unsigned int address,
    unsigned int width, unsigned int value);

static void vrd_q028_write_byte(unsigned int address, unsigned char value)
{
    vrd_q028_orig_write_byte(address, value);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 1, value, "write");
    vrd_q028_m68k_source_context(address, 1, value);
}

static void vrd_q028_m68k_source_context(unsigned int address,
    unsigned int width, unsigned int value)
{
    unsigned int i, sp, ret;
    extern M68K_CONTEXT PicoCpuFM68k;
    if (!vrd_q028_metadata_log || !vrd_q028_source_overlap(address & 0x00ffffffu,
            width))
        return;
    sp = PicoCpuFM68k.areg[7].D;
    ret = vrd_q028_orig_read_long(sp);
    if (fprintf(vrd_q028_metadata_log,
            "# M68K_SOURCE_CONTEXT sequence=%llu frame=%d pc=0x%08X "
            "address=0x%08X width=%u value=0x%08X sp=0x%08X "
            "caller=0x%08X",
            vrd_q028_sequence, vrd_profile_frame, vrd_mmio_trace_pc,
            address, width, value, sp, ret) < 0) {
        vrd_q028_errors++;
        return;
    }
    for (i = 0; i < 8; i++)
        if (fprintf(vrd_q028_metadata_log, " d%u=0x%08X", i,
                PicoCpuFM68k.dreg[i].D) < 0)
            vrd_q028_errors++;
    for (i = 0; i < 8; i++)
        if (fprintf(vrd_q028_metadata_log, " a%u=0x%08X", i,
                PicoCpuFM68k.areg[i].D) < 0)
            vrd_q028_errors++;
    if (fputc('\n', vrd_q028_metadata_log) == EOF)
        vrd_q028_errors++;
}

static void vrd_q028_write_word(unsigned int address, unsigned short value)
{
    vrd_q028_orig_write_word(address, value);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 2, value, "write");
    vrd_q028_m68k_source_context(address, 2, value);
}

static void vrd_q028_write_long(unsigned int address, unsigned int value)
{
    vrd_q028_orig_write_long(address, value);
    vrd_q028_event(0, "data", vrd_mmio_trace_pc, address, 4, value, "write");
    vrd_q028_m68k_source_context(address, 4, value);
}

static void vrd_q028_m68k_install(void)
{
    if ((!vrd_q028_log && !vrd_q028_command_log) || vrd_q028_m68k_installed)
        return;
    vrd_q028_orig_read_byte = PicoCpuFM68k.read_byte;
    vrd_q028_orig_read_word = PicoCpuFM68k.read_word;
    vrd_q028_orig_read_long = PicoCpuFM68k.read_long;
    vrd_q028_orig_write_byte = PicoCpuFM68k.write_byte;
    vrd_q028_orig_write_word = PicoCpuFM68k.write_word;
    vrd_q028_orig_write_long = PicoCpuFM68k.write_long;
    PicoCpuFM68k.read_byte = vrd_q028_read_byte;
    PicoCpuFM68k.read_word = vrd_q028_read_word;
    PicoCpuFM68k.read_long = vrd_q028_read_long;
    PicoCpuFM68k.write_byte = vrd_q028_write_byte;
    PicoCpuFM68k.write_word = vrd_q028_write_word;
    PicoCpuFM68k.write_long = vrd_q028_write_long;
    vrd_q028_m68k_installed = 1;
}

static void vrd_q028_m68k_uninstall(void)
{
    if (!vrd_q028_m68k_installed)
        return;
    PicoCpuFM68k.read_byte = vrd_q028_orig_read_byte;
    PicoCpuFM68k.read_word = vrd_q028_orig_read_word;
    PicoCpuFM68k.read_long = vrd_q028_orig_read_long;
    PicoCpuFM68k.write_byte = vrd_q028_orig_write_byte;
    PicoCpuFM68k.write_word = vrd_q028_orig_write_word;
    PicoCpuFM68k.write_long = vrd_q028_orig_write_long;
    vrd_q028_m68k_installed = 0;
}

unsigned int vrd_q028_bus_begin(unsigned int agent)
{
    unsigned int previous = vrd_q028_agent;
    if (vrd_q028_log) {
        if (agent <= VRD_Q028_AGENT_NONE || agent > VRD_Q028_AGENT_BRIDGE)
            vrd_q028_unknown++;
        else if (vrd_q028_agent == VRD_Q028_AGENT_NONE) {
            vrd_q028_agent = agent;
            vrd_q028_agent_hooks[agent]++;
        }
    }
    return previous;
}

void vrd_q028_bus_end(unsigned int previous)
{
    if (vrd_q028_log)
        vrd_q028_agent = previous;
}

void vrd_q028_sh2_fetch_begin(SH2 *sh2, unsigned int address)
{
    if (!vrd_q028_log)
        return;
    if (vrd_q028_fetch_cpu != 0)
        vrd_q028_unknown++;
    vrd_q028_fetch_cpu = sh2->is_slave ? 2 : 1;
    vrd_q028_fetch_address = address;
    vrd_q028_cpu_context[vrd_q028_fetch_cpu].pc = address;
    vrd_q028_cpu_context[vrd_q028_fetch_cpu].next_slot = 0;
    vrd_q028_cpu_context[vrd_q028_fetch_cpu].live = 0;
}

void vrd_q028_sh2_fetch_end(SH2 *sh2, unsigned int address)
{
    unsigned int cpu = sh2->is_slave ? 2 : 1;
    if (!vrd_q028_log)
        return;
    if (vrd_q028_fetch_cpu != cpu || vrd_q028_fetch_address != address)
        vrd_q028_unknown++;
    vrd_q028_fetch_cpu = 0;
    vrd_q028_fetch_address = 0;
}

void vrd_q028_sh2_access(SH2 *sh2, unsigned int address,
    unsigned int value, unsigned int op, unsigned int width)
{
    unsigned int cpu = sh2->is_slave ? 2 : 1;
    const char *kind = "data";
    unsigned int pc = sh2->ppc;
    if (vrd_q028_fetch_cpu == cpu && vrd_q028_fetch_address == address &&
        op == 0 && width == 2) {
        kind = "fetch";
        pc = address;
    }
    if (vrd_q028_agent == VRD_Q028_AGENT_IDL)
        vrd_q028_idl_count(op, address, width);
    vrd_q028_event(cpu, kind, pc, address, width, value,
        op ? "write" : "read");
}

void vrd_q028_sh2_irq(SH2 *sh2, unsigned int entering)
{
    unsigned int cpu = sh2->is_slave ? 1 : 0;
    if (!vrd_q028_log)
        return;
    if (entering)
        vrd_q028_irq_depth[cpu]++;
    else if (vrd_q028_irq_depth[cpu] != 0)
        vrd_q028_irq_depth[cpu]--;
    else
        vrd_q028_unknown++;
    if (vrd_q028_metadata_log && fprintf(vrd_q028_metadata_log, "# IRQ sequence=%llu frame=%d cpu=%s "
            "action=%s depth=%u pc=0x%08X\n", vrd_q028_sequence,
            vrd_profile_frame, sh2->is_slave ? "slave" : "master",
            entering ? "enter" : "exit", vrd_q028_irq_depth[cpu],
            sh2->ppc) < 0)
        vrd_q028_errors++;
}

void vrd_q028_sh2_instruction(SH2 *sh2, unsigned int pc,
    unsigned int opcode)
{
    if (!vrd_q028_log)
        return;
    if ((opcode & 0xffff) == 0x002b)
        vrd_q028_sh2_irq(sh2, 0);
    if (!sh2->is_slave)
        return;
    if (vrd_q028_cmd02_active && sh2->r[15] < vrd_q028_cmd02_min_sp)
        vrd_q028_cmd02_min_sp = sh2->r[15];
    if (vrd_q028_invocation_active && sh2->r[15] < vrd_q028_invocation_min_sp)
        vrd_q028_invocation_min_sp = sh2->r[15];
    if (pc == 0x06000fa8) {
        if (vrd_q028_cmd02_active)
            vrd_q028_unknown++;
        vrd_q028_cmd02_active = 1;
        vrd_q028_cmd02_entries++;
        vrd_q028_cmd02_entry_sp = sh2->r[15];
        vrd_q028_cmd02_min_sp = sh2->r[15];
    }
    if ((pc == 0x0600bbc0 || pc == 0x060024dc) &&
        !vrd_q028_invocation_active) {
        vrd_q028_invocation_active = 1;
        vrd_q028_invocation_entry_sp = sh2->r[15];
        vrd_q028_invocation_min_sp = sh2->r[15];
    }
    if (pc == 0x0600bbc0)
        vrd_q028_image("wrapper_entry", pc);
    else if (pc == 0x06000ff4 || pc == 0x06000ffe || pc == 0x06001016)
        vrd_q028_image("wrapper_return", pc);
    if (pc == 0x06000fa8 || pc == 0x0600bbc0 || pc == 0x060024dc ||
        pc == 0x0600442c || pc == 0x06000ff4 || pc == 0x06000ffe ||
        pc == 0x06001016) {
        if (vrd_q028_metadata_log && fprintf(vrd_q028_metadata_log,
                "# CONTEXT frame=%d pc=0x%08X opcode=0x%04X pr=0x%08X "
                "sr=0x%08X r0=0x%08X r1=0x%08X r2=0x%08X r3=0x%08X "
                "r4=0x%08X r5=0x%08X r6=0x%08X r7=0x%08X r13=0x%08X "
                "r14=0x%08X r15=0x%08X irq=%u\n",
                vrd_profile_frame, pc, opcode, sh2->pr, sh2->sr,
                sh2->r[0], sh2->r[1], sh2->r[2], sh2->r[3], sh2->r[4],
                sh2->r[5], sh2->r[6], sh2->r[7], sh2->r[13], sh2->r[14],
                sh2->r[15], vrd_q028_irq_depth[1]) < 0)
            vrd_q028_errors++;
    }
    if (pc == 0x0600442c && vrd_q028_cmd02_active) {
        if (vrd_q028_metadata_log && fprintf(vrd_q028_metadata_log,
                "# CMD02_STACK ordinal=%u entry=0x%08X min=0x%08X "
                "exit=0x%08X\n", vrd_q028_cmd02_entries,
                vrd_q028_cmd02_entry_sp, vrd_q028_cmd02_min_sp,
                sh2->r[15]) < 0)
            vrd_q028_errors++;
        vrd_q028_cmd02_active = 0;
        vrd_q028_cmd02_completions++;
    }
    if ((pc == 0x06000ff4 || pc == 0x06000ffe || pc == 0x06001016) &&
        vrd_q028_invocation_active) {
        vrd_q028_invocations++;
        if (vrd_q028_metadata_log && fprintf(vrd_q028_metadata_log,
                "# INVOCATION_STACK ordinal=%u caller=0x%08X entry=0x%08X "
                "min=0x%08X exit=0x%08X sr=0x%08X\n",
                vrd_q028_invocations, pc, vrd_q028_invocation_entry_sp,
                vrd_q028_invocation_min_sp, sh2->r[15], sh2->sr) < 0)
            vrd_q028_errors++;
        vrd_q028_invocation_active = 0;
    }
}

void vrd_q028_idl_begin(unsigned int external_bios)
{
    if (!vrd_q028_log)
        return;
    vrd_q028_bios_null = !external_bios;
    vrd_q028_bus_begin(VRD_Q028_AGENT_IDL);
    if (vrd_q028_metadata_log && fprintf(vrd_q028_metadata_log, "# IDL_BEGIN bios_null=%u\n",
            vrd_q028_bios_null) < 0)
        vrd_q028_errors++;
}

void vrd_q028_idl_end(void)
{
    if (!vrd_q028_log)
        return;
    vrd_q028_bus_end(VRD_Q028_AGENT_NONE);
    vrd_q028_idl_complete = 1;
    vrd_q028_image("idl_copy_end", 0);
    if (vrd_q028_metadata_log && fprintf(vrd_q028_metadata_log,
            "# IDL_COPY_END reads=%u writes=%u bios_null=%u\n",
            vrd_q028_idl_reads, vrd_q028_idl_writes,
            vrd_q028_bios_null) < 0 || (vrd_q028_metadata_log && fflush(vrd_q028_metadata_log) != 0))
        vrd_q028_errors++;
}

void vrd_q028_idl_count(unsigned int is_write, unsigned int address,
    unsigned int width)
{
    unsigned int normalized;
    const char *space;
    if (!vrd_q028_log || vrd_q028_agent != VRD_Q028_AGENT_IDL)
        return;
    normalized = vrd_q028_normalize(address, 1, &space);
    if (width == 4) {
        if (is_write) vrd_q028_idl_writes++;
        else vrd_q028_idl_reads++;
    }
    if (width == 4 && (vrd_q028_overlaps(normalized, width,
            0x0202bbc0, 0x0202bce8) ||
            vrd_q028_overlaps(normalized, width,
                VRD_Q028_CODE_START, VRD_Q028_CODE_END))) {
        if (is_write) vrd_q028_idl_target_writes++;
        else vrd_q028_idl_target_reads++;
    }
}

void vrd_q028_memcpy_source(SH2 *sh2, unsigned int src,
    unsigned int count, unsigned int size, const unsigned char *source)
{
    unsigned int i, value;
    if (!vrd_q028_log)
        return;
    for (i = 0; i < count; i++) {
        if (size == 1) value = source[i];
        else if (size == 2) memcpy(&value, source + i * 2, 2), value &= 0xffff;
        else if (size == 4) memcpy(&value, source + i * 4, 4);
        else { vrd_q028_unknown++; return; }
        vrd_q028_event(sh2->is_slave ? 2 : 1, "data", sh2->ppc,
            src + i * size, size, value, "read");
    }
}

static void vrd_q028_early_init(void)
{
    const char *path = getenv("VRD_Q028_ACCESS_LOG");
    const char *run_kind = getenv("VRD_Q028_RUN_KIND");
    const char *family = getenv("VRD_Q028_FAMILY");
    const char *arm = getenv("VRD_Q028_ARM");
    const char *capture_dir = getenv("VRD_Q028_CAPTURE_DIR");
    const char *capture_start = getenv("VRD_Q028_CAPTURE_START");
    const char *capture_end = getenv("VRD_Q028_CAPTURE_END");
    const char *terminal_dir = getenv("VRD_Q028_TERMINAL_DIR");
    const char *command_path = getenv("VRD_Q028_DRC_COMMAND_LOG");
    if (command_path && *command_path) {
        vrd_q028_command_log = fopen(command_path, "wx");
        if (!vrd_q028_command_log || fprintf(vrd_q028_command_log,
                "sequence,frame,cpu,pc,address,width,value,game,tags,lane_mask\n") < 0)
            vrd_q028_errors++;
    }
    if (terminal_dir && *terminal_dir) {
        if (strlen(terminal_dir) >= sizeof(vrd_q028_terminal_dir))
            vrd_q028_errors++;
        else
            strcpy(vrd_q028_terminal_dir, terminal_dir);
    }
    if (capture_dir && *capture_dir && capture_start && capture_end) {
        char manifest_path[640];
        char state_manifest_path[640];
        char fs_manifest_path[640];
        char render_manifest_path[640];
        char callback_manifest_path[640];
        vrd_q028_capture_start = atoi(capture_start);
        vrd_q028_capture_end = atoi(capture_end);
        if (vrd_q028_capture_start < 0 ||
            vrd_q028_capture_end < vrd_q028_capture_start ||
            strlen(capture_dir) >= sizeof(vrd_q028_capture_dir)) {
            vrd_q028_errors++;
        }
        else {
            strcpy(vrd_q028_capture_dir, capture_dir);
            snprintf(manifest_path, sizeof(manifest_path), "%s/post-frame.csv",
                vrd_q028_capture_dir);
            vrd_q028_capture_manifest = fopen(manifest_path, "wx");
            snprintf(state_manifest_path, sizeof(state_manifest_path),
                "%s/state-images.csv", vrd_q028_capture_dir);
            vrd_q028_state_manifest = fopen(state_manifest_path, "wx");
            snprintf(fs_manifest_path, sizeof(fs_manifest_path),
                "%s/fs-preapply.csv", vrd_q028_capture_dir);
            vrd_q028_fs_manifest = fopen(fs_manifest_path, "wx");
            snprintf(render_manifest_path, sizeof(render_manifest_path),
                "%s/render-select.csv", vrd_q028_capture_dir);
            vrd_q028_render_manifest = fopen(render_manifest_path, "wx");
            snprintf(callback_manifest_path, sizeof(callback_manifest_path),
                "%s/callback-bind.csv", vrd_q028_capture_dir);
            vrd_q028_callback_manifest = fopen(callback_manifest_path, "wx");
            if (!vrd_q028_capture_manifest ||
                fprintf(vrd_q028_capture_manifest,
                    "frame,retro_run,event_order,fbctl,post_frame_fs,fen,page_bytes,page0_path,page1_path\n") < 0 ||
                !vrd_q028_state_manifest ||
                fprintf(vrd_q028_state_manifest,
                    "frame,space,bytes,path\n") < 0 ||
                !vrd_q028_fs_manifest ||
                fprintf(vrd_q028_fs_manifest,
                    "preapply_ordinal,frame,retro_run,event_order,site,old_fbctl,old_fs,new_fs,fen,page_bytes,page0_path,page1_path\n") < 0 ||
                !vrd_q028_render_manifest ||
                fprintf(vrd_q028_render_manifest,
                    "render_ordinal,frame,retro_run,event_order,fbctl,render_fs,offs,lines,sync_line,draw_mode,skip_frame,page_bytes,page0_path,page1_path\n") < 0 ||
                !vrd_q028_callback_manifest ||
                fprintf(vrd_q028_callback_manifest,
                    "callback_ordinal,frame,retro_run,event_order,render_ordinal,data_nonnull,width,height,pitch\n") < 0)
                vrd_q028_errors++;
        }
    }
    if (!path || !*path)
        return;
    if (strlen(path) >= sizeof(vrd_q028_access_dir)) {
        vrd_q028_errors++;
        return;
    }
    strcpy(vrd_q028_access_dir, path);
    if (run_kind && !strcmp(run_kind, "Q028_RESOURCE_PILOT_V9")) {
        vrd_q028_family = 0; vrd_q028_arm = 1;
    }
    else {
        vrd_q028_family = family && !strcmp(family, "A") ? 1 :
            (family && !strcmp(family, "B") ? 2 :
             (family && !strcmp(family, "C") ? 3 : 0));
        vrd_q028_arm = arm && !strcmp(arm, "baseline") ? 1 :
            (arm && !strcmp(arm, "control") ? 2 :
             (arm && !strcmp(arm, "active") ? 3 : 0));
    }
    if (!vrd_q028_arm) {
        vrd_q028_errors++;
        return;
    }
    snprintf(vrd_q028_footer_path, sizeof(vrd_q028_footer_path),
        "%s/access-footer-v8.json", vrd_q028_access_dir);
    {
        char metadata_path[640];
        snprintf(metadata_path, sizeof(metadata_path), "%s/access-metadata-v8.log",
            vrd_q028_access_dir);
        vrd_q028_metadata_log = fopen(metadata_path, "wx");
        snprintf(metadata_path,sizeof(metadata_path),"%s/host-rewrites-v10.csv",vrd_q028_access_dir);
        vrd_q028_host_log=fopen(metadata_path,"wx");
        if (!vrd_q028_host_log || fprintf(vrd_q028_host_log,
            "ordinal,before_sequence,frame,cpu,pc,old_word,new_word,operation,source\n")<0) vrd_q028_errors++;
    }
    if (!vrd_q028_metadata_log || sizeof(struct vrd_q028_record) != 48 ||
        sizeof(struct vrd_q028_chunk_header) != 64 || !vrd_q028_open_chunk()) {
        vrd_q028_errors++;
        return;
    }
    vrd_q028_active = 1;
    if (fprintf(vrd_q028_metadata_log,
            "Q028_OBSERVER version=%u run_kind=%s family=%s arm=%s "
            "unfiltered=true record_size=%u records_per_chunk=%u\n",
            VRD_Q028_OBSERVER_VERSION, run_kind ? run_kind : "campaign",
            family ? family : "ordinary", arm ? arm : "baseline",
            (unsigned)sizeof(struct vrd_q028_record),
            VRD_Q028_RECORDS_PER_CHUNK) < 0)
        vrd_q028_errors++;
}

static int vrd_q028_snapshot_pages(const char *stem, char paths[2][160])
{
    unsigned int page;
    if (!Pico32xMem || !stem) return 0;
    for (page = 0; page < 2; page++) {
        char full[640];
        FILE *stream;
        int ok = 0;
        snprintf(paths[page], 160, "%s-page-%u.bin", stem, page);
        snprintf(full, sizeof(full), "%s/%s", vrd_q028_capture_dir,
            paths[page]);
        stream = fopen(full, "wbx");
        if (stream) {
            ok = fwrite(Pico32xMem->dram[page], 1, 0x20000, stream) ==
                0x20000;
            if (fclose(stream) != 0) ok = 0;
        }
        if (!ok) return 0;
    }
    return 1;
}

void vrd_q028_render_select(unsigned int fbctl, int offs, int lines,
    int sync_line, int draw_mode, int skip_frame)
{
    char stem[96], paths[2][160] = {{0}};
    unsigned int page_bytes = 0;
    unsigned int reread;
    if (!vrd_q028_render_manifest) return;
    vrd_q028_display_order++;
    vrd_q028_render_ordinal++;
    vrd_q028_render_events_in_frame++;
    if (vrd_q028_pending_render != 0 ||
        vrd_q028_pending_render_frame == vrd_profile_frame)
        vrd_q028_errors++;
    vrd_q028_pending_render = vrd_q028_render_ordinal;
    vrd_q028_pending_render_frame = vrd_profile_frame;
    if (vrd_profile_frame >= vrd_q028_capture_start &&
        vrd_profile_frame <= vrd_q028_capture_end) {
        snprintf(stem, sizeof(stem), "render-%04d", vrd_profile_frame);
        if (!vrd_q028_snapshot_pages(stem, paths))
            vrd_q028_errors++;
        else
            page_bytes = 131072;
    }
    reread = Pico32x.vdp_regs[0x0a / 2];
    if (reread != fbctl ||
        fprintf(vrd_q028_render_manifest,
            "%llu,%d,%d,%llu,0x%04X,%u,%d,%d,%d,%d,%d,%u,%s,%s\n",
            vrd_q028_render_ordinal, vrd_profile_frame, vrd_profile_frame,
            vrd_q028_display_order, fbctl & 0xffff,
            (fbctl & P32XV_FS) != 0, offs, lines, sync_line, draw_mode,
            skip_frame, page_bytes, page_bytes ? paths[0] : "-",
            page_bytes ? paths[1] : "-") < 0 ||
        fflush(vrd_q028_render_manifest) != 0)
        vrd_q028_errors++;
}

void vrd_q028_callback_dispatch(const void *data, unsigned int width,
    unsigned int height, unsigned int pitch)
{
    unsigned long long bound = 0;
    if (!vrd_q028_callback_manifest) return;
    vrd_q028_display_order++;
    vrd_q028_callback_ordinal++;
    vrd_q028_callback_events_in_frame++;
    if (vrd_q028_pending_render_frame == vrd_profile_frame)
        bound = vrd_q028_pending_render;
    if (vrd_profile_frame >= vrd_q028_capture_start &&
        vrd_profile_frame <= vrd_q028_capture_end &&
        (bound == 0 || vrd_q028_render_events_in_frame != 1 ||
         vrd_q028_callback_events_in_frame != 1))
        vrd_q028_errors++;
    if (fprintf(vrd_q028_callback_manifest,
            "%llu,%d,%d,%llu,%llu,%u,%u,%u,%u\n",
            vrd_q028_callback_ordinal, vrd_profile_frame, vrd_profile_frame,
            vrd_q028_display_order, bound, data != NULL, width, height,
            pitch) < 0 || fflush(vrd_q028_callback_manifest) != 0)
        vrd_q028_errors++;
    vrd_q028_pending_render = 0;
    vrd_q028_pending_render_frame = -1;
    vrd_q028_render_events_in_frame = 0;
    vrd_q028_callback_events_in_frame = 0;
}

static void vrd_q028_capture_frame(void)
{
    unsigned int fbctl;
    char stem[96], paths[2][160] = {{0}};
    if (!vrd_q028_capture_manifest || !Pico32xMem ||
        vrd_profile_frame < vrd_q028_capture_start ||
        vrd_profile_frame > vrd_q028_capture_end)
        return;
    fbctl = Pico32x.vdp_regs[0x0a / 2];
    vrd_q028_display_order++;
    snprintf(stem, sizeof(stem), "post-frame-%04d", vrd_profile_frame);
    if (!vrd_q028_snapshot_pages(stem, paths) ||
        Pico32x.vdp_regs[0x0a / 2] != fbctl ||
        fprintf(vrd_q028_capture_manifest,
            "%d,%d,%llu,0x%04X,%u,%u,131072,%s,%s\n",
            vrd_profile_frame, vrd_profile_frame, vrd_q028_display_order,
            fbctl & 0xffff, (fbctl & P32XV_FS) != 0,
            (fbctl & P32XV_nFEN) != 0, paths[0], paths[1]) < 0)
        vrd_q028_errors++;
    {
        const void *images[2] = { PicoMem.ram, Pico32xMem->sdram };
        const char *spaces[2] = { "wram", "sdram" };
        const unsigned int sizes[2] = { 0x10000, 0x40000 };
        unsigned int i;
        for (i = 0; i < 2; i++) {
            char path[640];
            FILE *stream;
            int ok = 0;
            snprintf(path, sizeof(path), "%s/frame-%04d-%s.bin",
                vrd_q028_capture_dir, vrd_profile_frame, spaces[i]);
            stream = fopen(path, "wbx");
            if (stream) {
                ok = fwrite(images[i], 1, sizes[i], stream) == sizes[i];
                if (fclose(stream) != 0)
                    ok = 0;
            }
            if (!ok || !vrd_q028_state_manifest ||
                fprintf(vrd_q028_state_manifest, "%d,%s,%u,frame-%04d-%s.bin\n",
                    vrd_profile_frame, spaces[i], sizes[i],
                    vrd_profile_frame, spaces[i]) < 0)
                vrd_q028_errors++;
        }
    }
    if (fflush(vrd_q028_capture_manifest) != 0)
        vrd_q028_errors++;
    if (!vrd_q028_state_manifest || fflush(vrd_q028_state_manifest) != 0)
        vrd_q028_errors++;
}

void vrd_q028_fs_preapply(const char *site, unsigned int old_fbctl,
    unsigned int new_fs)
{
    unsigned int old_fs = (old_fbctl & P32XV_FS) != 0;
    unsigned int fen = (old_fbctl & P32XV_nFEN) != 0;
    char stem[96], paths[2][160] = {{0}};
    if (vrd_q028_capture_start < 0)
        return;
    if (vrd_profile_frame < vrd_q028_capture_start ||
        vrd_profile_frame > vrd_q028_capture_end)
        return;
    if (!vrd_q028_fs_manifest || !Pico32xMem || !site || old_fs == new_fs) {
        vrd_q028_fs_errors++;
        vrd_q028_errors++;
        return;
    }
    vrd_q028_fs_snapshots++;
    vrd_q028_display_order++;
    snprintf(stem, sizeof(stem), "preapply-%04u-frame-%04d-%s",
        vrd_q028_fs_snapshots, vrd_profile_frame, site);
    if (!vrd_q028_snapshot_pages(stem, paths) ||
        fprintf(vrd_q028_fs_manifest,
            "%u,%d,%d,%llu,%s,0x%04X,%u,%u,%u,131072,%s,%s\n",
            vrd_q028_fs_snapshots, vrd_profile_frame, vrd_profile_frame,
            vrd_q028_display_order, site, old_fbctl & 0xffff, old_fs,
            new_fs, fen, paths[0], paths[1]) < 0) {
        vrd_q028_fs_errors++;
        vrd_q028_errors++;
    }
    if (fflush(vrd_q028_fs_manifest) != 0) {
        vrd_q028_fs_errors++;
        vrd_q028_errors++;
    }
}

static void vrd_q028_finish(const char *reason)
{
    unsigned int no_open_context;
    if (vrd_q028_capture_start >= 0) {
        char path[640];
        FILE *stream;
        snprintf(path, sizeof(path), "%s/capture-session.csv",
            vrd_q028_capture_dir);
        stream = fopen(path, "wx");
        if (!stream) vrd_q028_errors++;
        else {
            if (fprintf(stream,
                "observer_version,start,end,fs_snapshots,fs_errors,sh2_interpreter\n"
                "%u,%d,%d,%u,%u,%u\n", VRD_Q028_OBSERVER_VERSION,
                vrd_q028_capture_start, vrd_q028_capture_end,
                vrd_q028_fs_snapshots, vrd_q028_fs_errors,
                (PicoIn.opt & POPT_EN_DRC) == 0) < 0) vrd_q028_errors++;
            if (fclose(stream) != 0) vrd_q028_errors++;
        }
    }
    if (vrd_q028_terminal_dir[0]) {
        const void *images[2] = { PicoMem.ram, Pico32xMem->sdram };
        const char *spaces[2] = { "wram", "sdram" };
        const unsigned int sizes[2] = { 0x10000, 0x40000 };
        unsigned int i;
        for (i = 0; i < 2; i++) {
            char path[640];
            FILE *stream;
            int ok = 0;
            snprintf(path, sizeof(path), "%s/terminal-%s.bin",
                vrd_q028_terminal_dir, spaces[i]);
            stream = fopen(path, "wbx");
            if (stream) {
                ok = fwrite(images[i], 1, sizes[i], stream) == sizes[i];
                if (fclose(stream) != 0)
                    ok = 0;
            }
            if (!ok)
                vrd_q028_errors++;
        }
    }
    if (vrd_q028_capture_manifest) {
        if (fclose(vrd_q028_capture_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_capture_manifest = NULL;
    }
    if (vrd_q028_state_manifest) {
        if (fclose(vrd_q028_state_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_state_manifest = NULL;
    }
    if (vrd_q028_fs_manifest) {
        if (fclose(vrd_q028_fs_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_fs_manifest = NULL;
    }
    if (vrd_q028_render_manifest) {
        if (fclose(vrd_q028_render_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_render_manifest = NULL;
    }
    if (vrd_q028_callback_manifest) {
        if (fclose(vrd_q028_callback_manifest) != 0)
            vrd_q028_errors++;
        vrd_q028_callback_manifest = NULL;
    }
    if (vrd_q028_command_log) {
        if (fprintf(vrd_q028_command_log, "# COMPLETE,frames=%d,writes=%llu\n",
                vrd_profile_frame, vrd_q028_comm_writes) < 0) vrd_q028_errors++;
        if (fclose(vrd_q028_command_log) != 0) vrd_q028_errors++;
        vrd_q028_command_log = NULL;
    }
    if (!vrd_q028_active)
        return;
    if (vrd_q028_log)
        vrd_q028_image("terminal", 0);
    vrd_q028_m68k_uninstall();
    if (vrd_q028_capture_start >= 0 &&
        (vrd_q028_fs_errors != 0 || vrd_q028_fs_snapshots == 0 ||
         vrd_q028_pending_render != 0))
        vrd_q028_errors++;
    if (vrd_q028_log && !vrd_q028_close_chunk())
        vrd_q028_errors++;
    no_open_context = vrd_q028_agent == VRD_Q028_AGENT_NONE &&
        vrd_q028_fetch_cpu == 0 && vrd_q028_irq_depth[0] == 0 &&
        vrd_q028_irq_depth[1] == 0 && !vrd_q028_cmd02_active && !vrd_q028_invocation_active &&
        !vrd_q028_sram_state[1].installing && !vrd_q028_sram_state[2].installing;
    if (!no_open_context || !vrd_q028_bios_verified) vrd_q028_errors++;
    if (vrd_q028_wram_state.installing) vrd_q028_errors++;
    if (vrd_q028_host_log) {
        if (fprintf(vrd_q028_host_log,"# COMPLETE,events=%llu,frames=%d,count=%llu,last_boundary=%llu\n",
            vrd_q028_events,vrd_profile_frame,vrd_q028_host_count,vrd_q028_host_last_boundary)<0) vrd_q028_errors++;
        if (fclose(vrd_q028_host_log)!=0) vrd_q028_errors++;
        vrd_q028_host_log=NULL;
    }
    else vrd_q028_errors++;
    if (vrd_q028_metadata_log) {
        if (fprintf(vrd_q028_metadata_log,
            "COMPLETE reason=%s events=%llu errors=%llu unknown=%llu dropped=%llu unattributed=%llu\n",
            vrd_q028_resource_limit ? "RESOURCE_LIMIT" : reason,
            vrd_q028_events, vrd_q028_errors, vrd_q028_unknown,
            vrd_q028_dropped, vrd_q028_unattributed) < 0) vrd_q028_errors++;
        if (fclose(vrd_q028_metadata_log) != 0) vrd_q028_errors++;
        vrd_q028_metadata_log = NULL;
    }
    {
        FILE *footer = fopen(vrd_q028_footer_path, "wx");
        /* JSON member order is lexical; event IDs keep their existing ABI. */
        static const unsigned int agent_order[] = {
            VRD_Q028_AGENT_BRIDGE, VRD_Q028_AGENT_IDL,
            VRD_Q028_AGENT_M_DMAC0, VRD_Q028_AGENT_M_DMAC1,
            VRD_Q028_AGENT_M_DREQ0, VRD_Q028_AGENT_M_DREQ1,
            VRD_Q028_AGENT_S_DMAC0, VRD_Q028_AGENT_S_DMAC1,
            VRD_Q028_AGENT_S_DREQ0, VRD_Q028_AGENT_S_DREQ1
        };
        unsigned int agent_index;
        unsigned int fetch_complete = vrd_q028_cpu_counts[0][0] != 0 &&
            vrd_q028_cpu_counts[1][0] != 0 && vrd_q028_cpu_counts[2][0] != 0;
        unsigned int cpu_data_complete =
            vrd_q028_cpu_counts[0][1] + vrd_q028_cpu_counts[0][2] != 0 &&
            vrd_q028_cpu_counts[1][1] + vrd_q028_cpu_counts[1][2] != 0 &&
            vrd_q028_cpu_counts[2][1] + vrd_q028_cpu_counts[2][2] != 0;
        if (!footer || fprintf(footer,
            "{\"agent_counts\":{") < 0) {
            vrd_q028_errors++;
        }
        else {
            for (agent_index = 0; agent_index < sizeof(agent_order) / sizeof(agent_order[0]); agent_index++) {
                unsigned int agent = agent_order[agent_index];
                if (agent_index != 0) fputc(',', footer);
                fprintf(footer, "\"%s\":{\"hook_entries\":%llu,\"records\":%llu}",
                    vrd_q028_agent_name(agent), vrd_q028_agent_hooks[agent],
                    vrd_q028_agent_records[agent]);
            }
            fprintf(footer,
                "},\"bios_null\":%u,\"chunks\":%u,\"cmd02_completions\":%u,"
                "\"cmd02_entries\":%u,\"cmd02_open\":%u,\"comm\":{"
                "\"boot_reads\":%u,\"boot_route\":%u,\"counts\":[%llu,%llu,%llu,%llu,%llu],\"game\":%u,"
                "\"lanes\":[%u,%u,%u,%u,%u,%u,%u,%u],"
                "\"last\":[%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu],\"writes\":%llu},\"cpu_counts\":{"
                "\"m68k\":{\"fetch\":%llu,\"read\":%llu,\"write\":%llu},"
                "\"master\":{\"fetch\":%llu,\"read\":%llu,\"write\":%llu},"
                "\"slave\":{\"fetch\":%llu,\"read\":%llu,\"write\":%llu}},"
                "\"cpu_data_complete\":%s,\"dma_dreq_bridge_complete\":%s,"
                "\"dropped\":%llu,\"errors\":%llu,\"events\":%llu,"
                "\"fetch_complete\":%s,\"frames\":%d,"
                "\"host_rewrites\":{\"count\":%llu,\"last_boundary\":%llu},\"idl_complete\":%u,"
                "\"idl_reads\":%u,\"idl_target_reads\":%u,"
                "\"idl_target_writes\":%u,\"idl_writes\":%u,\"no_open_context\":%s,"
                "\"reason\":\"%s\",\"resource_limit\":%s,"
                "\"schema\":\"vrd-vr60-q028-access-footer-v8\","
                "\"sh2_interpreter\":%u,\"unattributed\":%llu,\"unknown\":%llu}\n",
                vrd_q028_bios_null, vrd_q028_chunk_ordinal,
                vrd_q028_cmd02_completions, vrd_q028_cmd02_entries,
                vrd_q028_cmd02_active,
                vrd_q028_comm_boot_reads, vrd_q028_comm_boot_route,
                vrd_q028_comm_counts[0], vrd_q028_comm_counts[1], vrd_q028_comm_counts[2],
                vrd_q028_comm_counts[3], vrd_q028_comm_counts[4], vrd_q028_comm_game,
                vrd_q028_comm_lanes[0], vrd_q028_comm_lanes[1], vrd_q028_comm_lanes[2], vrd_q028_comm_lanes[3],
                vrd_q028_comm_lanes[4], vrd_q028_comm_lanes[5], vrd_q028_comm_lanes[6], vrd_q028_comm_lanes[7],
                vrd_q028_comm_last[0], vrd_q028_comm_last[1], vrd_q028_comm_last[2], vrd_q028_comm_last[3],
                vrd_q028_comm_last[4], vrd_q028_comm_last[5], vrd_q028_comm_last[6], vrd_q028_comm_last[7],
                vrd_q028_comm_writes,
                vrd_q028_cpu_counts[0][0], vrd_q028_cpu_counts[0][1], vrd_q028_cpu_counts[0][2],
                vrd_q028_cpu_counts[1][0], vrd_q028_cpu_counts[1][1], vrd_q028_cpu_counts[1][2],
                vrd_q028_cpu_counts[2][0], vrd_q028_cpu_counts[2][1], vrd_q028_cpu_counts[2][2],
                cpu_data_complete ? "true" : "false",
                no_open_context ? "true" : "false",
                vrd_q028_dropped, vrd_q028_errors, vrd_q028_events,
                fetch_complete ? "true" : "false", vrd_profile_frame,
                vrd_q028_host_count,vrd_q028_host_last_boundary,
                vrd_q028_idl_complete, vrd_q028_idl_reads,
                vrd_q028_idl_target_reads, vrd_q028_idl_target_writes,
                vrd_q028_idl_writes, no_open_context ? "true" : "false",
                vrd_q028_resource_limit ? "RESOURCE_LIMIT" : reason,
                vrd_q028_resource_limit ? "true" : "false",
                (PicoIn.opt & POPT_EN_DRC) == 0, vrd_q028_unattributed,
                vrd_q028_unknown);
        }
        if (footer) {
            if (ferror(footer)) vrd_q028_errors++;
            if (fclose(footer) != 0) vrd_q028_errors++;
        }
    }
    vrd_q028_active = 0;
    free(vrd_q028_host_patches); vrd_q028_host_patches=NULL; vrd_q028_host_patches_count=0;
    /* This final process-log marker also exposes footer-close failures which
     * cannot honestly be written back into the already closed footer itself. */
    /* libretro maps fprintf/FILE to RFILE; fd 2 remains the process log. */
    dprintf(2, "Q028_OBSERVER_TERMINAL_ERRORS=%llu\n", vrd_q028_errors);
}
